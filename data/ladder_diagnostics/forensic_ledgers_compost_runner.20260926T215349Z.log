    28	def now() -> str:
    29	    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()
    30	
    31	
    32	def sha256_text(value: str) -> str:
    33	    return hashlib.sha256(value.encode("utf-8")).hexdigest()
    34	
    35	
    36	def connect() -> sqlite3.Connection:
    37	    DATA.mkdir(parents=True, exist_ok=True)
    38	    con = sqlite3.connect(DB)
    39	    con.execute(
    40	        """
    41	        CREATE TABLE IF NOT EXISTS candidates (
    42	            candidate_id TEXT PRIMARY KEY,
    43	            path TEXT NOT NULL,
    44	            reason TEXT NOT NULL,
    45	            visibility REAL NOT NULL DEFAULT 1.0,
    46	            reach REAL NOT NULL DEFAULT 1.0,
    47	            sysfit REAL NOT NULL DEFAULT 1.0,
    48	            floor_weight REAL NOT NULL DEFAULT 1.0,
    49	            effort REAL NOT NULL DEFAULT 1.0,
    50	            score REAL NOT NULL,
    51	            status TEXT NOT NULL DEFAULT 'registered_no_delete',
    52	            keypoints TEXT NOT NULL DEFAULT '',
    53	            created_at TEXT NOT NULL,
    54	            updated_at TEXT NOT NULL
    55	        )
    56	        """
    57	    )
    58	    con.execute(
    59	        """
    60	        CREATE VIRTUAL TABLE IF NOT EXISTS compost_fts
    61	        USING fts5(candidate_id UNINDEXED, path, reason, keypoints)
    62	        """
    63	    )
    64	    con.commit()
    65	    return con
    66	
    67	
    68	def keypoints(path: Path, limit: int = 12) -> str:
    69	    if not path.is_file():
    70	        return "path unavailable; metadata-only registration"
    71	    try:
    72	        raw = path.read_text(encoding="utf-8", errors="replace")
    73	    except OSError as exc:
    74	        return f"unreadable: {exc}"
    75	    found = []
    76	    for line in raw.splitlines():
    77	        clean = line.strip()
    78	        if re.match(r"^(#{1,6}\s+|[A-Z][A-Z0-9 _:-]{5,}$)", clean):
    79	            found.append(clean[:240])
    80	        if len(found) >= limit:
    81	            break
    82	    if found:
    83	        return "\n".join(found)
    84	    words = re.findall(r"[A-Za-z0-9][A-Za-z0-9_-]{2,}", raw[:12000])
    85	    return " ".join(words[:80]) if words else "no extractable text"
    86	
    87	
    88	def score(v: float, r: float, s: float, f: float, e: float) -> float:
    89	    if e <= 0:
    90	        raise ValueError("effort must be greater than zero")
    91	    return (v * r * s * f) / math.pow(e, 1.5)
    92	
    93	
    94	def register(args: argparse.Namespace) -> int:
    95	    con = connect()
    96	    candidate_path = Path(args.path)
    97	    resolved = str(candidate_path.resolve(strict=False))
    98	    points = keypoints(candidate_path)
    99	    value = score(args.visibility, args.reach, args.sysfit, args.floor_weight, args.effort)
   100	    cid = sha256_text(f"{resolved}\0{args.reason}")[:32]
   101	    timestamp = now()
   102	    con.execute(
   103	        """
   104	        INSERT INTO candidates(
   105	            candidate_id,path,reason,visibility,reach,sysfit,floor_weight,
   106	            effort,score,status,keypoints,created_at,updated_at
   107	        ) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)
   108	        ON CONFLICT(candidate_id) DO UPDATE SET
   109	            visibility=excluded.visibility,
   110	            reach=excluded.reach,
   111	            sysfit=excluded.sysfit,
   112	            floor_weight=excluded.floor_weight,
   113	            effort=excluded.effort,
   114	            score=excluded.score,
   115	            keypoints=excluded.keypoints,
   116	            updated_at=excluded.updated_at
   117	        """,
   118	        (
   119	            cid, resolved, args.reason, args.visibility, args.reach, args.sysfit,
   120	            args.floor_weight, args.effort, value, "registered_no_delete",
   121	            points, timestamp, timestamp,
   122	        ),
   123	    )
   124	    con.execute("DELETE FROM compost_fts WHERE candidate_id=?", (cid,))
   125	    con.execute(
   126	        "INSERT INTO compost_fts(candidate_id,path,reason,keypoints) VALUES(?,?,?,?)",
   127	        (cid, resolved, args.reason, points),
   128	    )
   129	    con.commit()
   130	    print(f"[banked] candidate_id={cid}")
   131	    print(f"[banked] score={value:.6f}")
   132	    print("[held] registered_no_delete; human review required before any external cleanup")
   133	    return 0
   134	
   135	
   136	def listing(_: argparse.Namespace) -> int:
   137	    con = connect()
   138	    rows = con.execute(
   139	        """
   140	        SELECT candidate_id,path,reason,round(score,6),status,updated_at
   141	        FROM candidates ORDER BY score DESC, updated_at DESC
   142	        """
   143	    ).fetchall()
   144	    for row in rows:
   145	        print("\t".join(str(value) for value in row))
   146	    print(f"[banked] candidates={len(rows)}")
   147	    return 0
   148	
   149	
   150	def search(args: argparse.Namespace) -> int:
   151	    con = connect()
   152	    rows = con.execute(
   153	        """
   154	        SELECT candidate_id,path,reason,keypoints
   155	        FROM compost_fts
   156	        WHERE compost_fts MATCH ?
   157	        LIMIT ?
   158	        """,
   159	        (args.query, args.limit),
   160	    ).fetchall()
   161	    for row in rows:
   162	        print(json.dumps({"id": row[0], "path": row[1], "reason": row[2], "keypoints": row[3]}, ensure_ascii=False))
   163	    print(f"[banked] matches={len(rows)}")
   164	    return 0
   165	
   166	
   167	def main() -> int:
   168	    parser = argparse.ArgumentParser(prog="compost_v1.py")
   169	    sub = parser.add_subparsers(dest="command", required=True)
   170	    add = sub.add_parser("register")
   171	    add.add_argument("path")
   172	    add.add_argument("reason")
   173	    add.add_argument("--visibility", type=float, default=1.0)
   174	    add.add_argument("--reach", type=float, default=1.0)
   175	    add.add_argument("--sysfit", type=float, default=1.0)
   176	    add.add_argument("--floor-weight", type=float, default=1.0)
   177	    add.add_argument("--effort", type=float, default=1.0)
   178	    add.set_defaults(func=register)
   179	    ls = sub.add_parser("list")
   180	    ls.set_defaults(func=listing)
   181	    find = sub.add_parser("search")
   182	    find.add_argument("query")
   183	    find.add_argument("--limit", type=int, default=20)
   184	    find.set_defaults(func=search)
   185	    args = parser.parse_args()
   186	    return args.func(args)
