     1	#!/usr/bin/env python3
     2	# SPDX-License-Identifier: GPL-3.0-only
     3	"""
     4	[COMPOSTV1] OpenRoot waste-stream transmutation ledger.
     5	
     6	Registers candidates without deleting anything, extracts conservative keypoints,
     7	indexes records with SQLite FTS5 when available, and ranks release candidates.
     8	No delete operation exists in this utility.
     9	"""
    10	from __future__ import annotations
    11	
    12	import argparse
    13	import hashlib
    14	import json
    15	import math
    16	import re
    17	import sqlite3
    18	import sys
    19	from datetime import datetime, timezone
    20	from pathlib import Path
    21	
    22	REPO = Path("/home/jesse/openroot")
    23	DATA = REPO / "data"
    24	DB = DATA / "compost_v1.db"
    25	TAG = "[COMPOSTV1]"
