goals_history   sessions        system_changes  tidbits       
name            sql                                                                                   
--------------  --------------------------------------------------------------------------------------
goals_history   CREATE TABLE goals_history(                                                           
                      id INTEGER PRIMARY KEY, goal_text TEXT, status TEXT, created TEXT, updated TEXT,
                      session_start TEXT)                                                             

sessions        CREATE TABLE sessions(                                                                
                      id INTEGER PRIMARY KEY, session_id TEXT UNIQUE, started TEXT, ended TEXT,       
                      head TEXT, status TEXT, notes TEXT)                                             

system_changes  CREATE TABLE system_changes(                                                          
                      id INTEGER PRIMARY KEY, script_name TEXT, version TEXT, action TEXT,            
                      verified INTEGER DEFAULT 0, timestamp TEXT)                                     

tidbits         CREATE TABLE tidbits(                                                                 
                      id INTEGER PRIMARY KEY, sha256 TEXT UNIQUE, size_kb INTEGER, kind TEXT,         
                      content_summary TEXT, created TEXT, composted INTEGER DEFAULT 0)                

