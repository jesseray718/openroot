   172	    if not ok:
   173	        report_mistake(con, st["name"], f"calibration: {out}"); return False
   174	    con.execute("UPDATE stages SET status='calibrated', last_action='calibration PASSED (real, bounded)', "
   175	                "last_ts=?, evidence=? WHERE name=?", (now(), out[:200], st["name"]))
   176	    con.commit()
   177	    print(f"[banked] calibration PASSED → {st['name']} promoted to CALIBRATED")
   178	    return True
