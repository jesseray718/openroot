   148	def stage_idx(name): return next(i for i, s in enumerate(STAGES) if s["name"] == name)
   149	
   150	def prior_verified(con, idx):
   151	    return idx == 0 or con.execute(
   152	        "SELECT status FROM stages WHERE name=?", (STAGES[idx-1]["name"],)
   153	    ).fetchone()[0] == "verified"
