   163	def run_checks(con, st):
   164	    for chk in st["checks"]:
   165	        ok, out = sh(chk, timeout=120)
   166	        if not ok:
   167	            return False, f"CHECK FAILED: {chk[:100]} | {out}"
   168	    return True, "all checks green"
