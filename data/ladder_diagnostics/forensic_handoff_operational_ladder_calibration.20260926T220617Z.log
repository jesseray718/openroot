   135	def connect():
   136	    con = sqlite3.connect(str(DB))
   137	    con.executescript("""
   138	    CREATE TABLE IF NOT EXISTS stages(
   139	      name TEXT PRIMARY KEY, status TEXT DEFAULT 'locked',
   140	      maturity TEXT DEFAULT 'human', checks_ok INTEGER DEFAULT 0, attempts INTEGER DEFAULT 0,
   141	      last_action TEXT, last_ts TEXT, evidence TEXT);
   142	    """)
   143	    for s in STAGES:
   144	        con.execute("INSERT INTO stages(name, maturity) VALUES(?, ?) ON CONFLICT(name) DO UPDATE SET maturity=excluded.maturity", (s["name"], s["maturity"]))
   145	    con.commit()
   146	    return con
