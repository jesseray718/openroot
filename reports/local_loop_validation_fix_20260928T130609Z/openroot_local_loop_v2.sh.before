#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

REPO="${REPO:-$HOME/openroot}"
STATE_DIR="${STATE_DIR:-$REPO/.openroot}"
DATA_DIR="${DATA_DIR:-$REPO/data}"
REPORTS_DIR="${REPORTS_DIR:-$REPO/reports}"
INBOX_DIR="${INBOX_DIR:-$REPO/lumo_inbox}"
OUTBOX_DIR="${OUTBOX_DIR:-$REPO/lumo_outbox}"
HOLDS_DIR="${HOLDS_DIR:-$DATA_DIR/operator_holds}"
HOLD_FILE="${HOLD_FILE:-$HOLDS_DIR/HUMAN_HOLD}"
DB="${DB:-$DATA_DIR/openroot_local_loop.db}"
MODEL="${MODEL:-}"
MAX_INBOX_BYTES="${MAX_INBOX_BYTES:-262144}"
MAX_TASKS="${MAX_TASKS:-12}"
RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)_$$_${RANDOM}"
RUN_DIR="$REPORTS_DIR/local_loop_$RUN_ID"
LOCK_DIR="$STATE_DIR/locks"
LOCK_FILE="$LOCK_DIR/local_loop.lock"
EVIDENCE_JSON="$RUN_DIR/evidence.json"
TASKS_JSON="$RUN_DIR/tasks.json"
ROUTES_JSON="$RUN_DIR/routes.json"
PACKET_MD="$RUN_DIR/task_packet.md"
PROPOSAL_MD="$RUN_DIR/local_proposal.md"
SUMMARY_JSON="$RUN_DIR/summary.json"

die() {
  printf '[fatal] %s\n' "$*" >&2
  exit 1
}

note() {
  printf '[openroot] %s\n' "$*"
}

require() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

cleanup() {
  rm -f "$LOCK_FILE" 2>/dev/null || true
}

trap cleanup EXIT INT TERM

require git
require python3
require sqlite3

[[ -d "$REPO/.git" ]] || die "not a Git repository: $REPO"

mkdir -p \
  "$STATE_DIR" \
  "$DATA_DIR" \
  "$REPORTS_DIR" \
  "$INBOX_DIR" \
  "$OUTBOX_DIR" \
  "$HOLDS_DIR" \
  "$LOCK_DIR" \
  "$RUN_DIR"

chmod 700 \
  "$STATE_DIR" \
  "$INBOX_DIR" \
  "$OUTBOX_DIR" \
  "$HOLDS_DIR" \
  "$LOCK_DIR" \
  "$RUN_DIR"

cd "$REPO"

if [[ -e "$LOCK_FILE" ]]; then
  OLD_PID="$(cat "$LOCK_FILE" 2>/dev/null || true)"
  if [[ -n "$OLD_PID" ]] && kill -0 "$OLD_PID" 2>/dev/null; then
    die "local loop already running: pid=$OLD_PID"
  fi
fi

printf '%s\n' "$$" > "$LOCK_FILE"
chmod 600 "$LOCK_FILE"

HEAD="$(git rev-parse HEAD)"
BRANCH="$(git branch --show-current || true)"
UPSTREAM="$(git rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || true)"
GIT_STATUS="$(git status --porcelain=v1)"
GIT_DIRTY=false
HOLD_PRESENT=false

[[ -n "$GIT_STATUS" ]] && GIT_DIRTY=true
[[ -e "$HOLD_FILE" ]] && HOLD_PRESENT=true

note "run_id=$RUN_ID"
note "repo=$REPO"
note "head=$HEAD"
note "branch=${BRANCH:-DETACHED}"
note "git_dirty=$GIT_DIRTY"
note "human_hold=$HOLD_PRESENT"
note "mutation=disabled"
note "network_compute=disabled"
note "blockchain_compute=disabled"

python3 - "$DB" "$RUN_ID" "$REPO" "$HEAD" "${BRANCH:-DETACHED}" "$GIT_DIRTY" "$HOLD_PRESENT" "$MODEL" "$RUN_DIR" <<'PY'
import sqlite3
import sys

db, run_id, repo, head, branch, dirty, hold, model, run_dir = sys.argv[1:]

con = sqlite3.connect(db, timeout=10)
try:
    con.execute("PRAGMA journal_mode=WAL")
    con.execute("PRAGMA synchronous=NORMAL")
    con.execute("PRAGMA foreign_keys=ON")
    con.execute("PRAGMA busy_timeout=5000")

    con.execute("PRAGMA foreign_keys=OFF")

    loop_columns = {
        row[1] for row in con.execute("PRAGMA table_info(loop_runs)")
    }

    if loop_columns and "git_head" not in loop_columns:
        raise RuntimeError(
            "loop_runs schema is stale: run the schema migration before starting the local loop"
        )

    con.executescript(
        """
        CREATE TABLE IF NOT EXISTS loop_runs (
          run_id TEXT PRIMARY KEY,
          started_at TEXT NOT NULL,
          finished_at TEXT,
          repo TEXT NOT NULL,
          git_head TEXT,
          branch TEXT,
          git_dirty INTEGER NOT NULL DEFAULT 0,
          hold_present INTEGER NOT NULL DEFAULT 0,
          model TEXT,
          status TEXT NOT NULL,
          report_dir TEXT NOT NULL,
          evidence_json TEXT,
          tasks_json TEXT,
          proposal_path TEXT,
          error_text TEXT
        );

        CREATE TABLE IF NOT EXISTS inbox_items (
          id INTEGER PRIMARY KEY,
          path TEXT NOT NULL UNIQUE,
          sha256 TEXT NOT NULL,
          bytes INTEGER NOT NULL,
          mtime_epoch INTEGER NOT NULL,
          ingested_at TEXT NOT NULL,
          processed_at TEXT,
          status TEXT NOT NULL DEFAULT 'new',
          title TEXT,
          content TEXT NOT NULL,
          route TEXT,
          priority INTEGER NOT NULL DEFAULT 50,
          run_id TEXT,
          error_text TEXT
        );

        CREATE INDEX IF NOT EXISTS idx_inbox_status_priority
        ON inbox_items(status, priority DESC, id ASC);

        CREATE INDEX IF NOT EXISTS idx_inbox_sha256
        ON inbox_items(sha256);

        CREATE VIRTUAL TABLE IF NOT EXISTS inbox_fts USING fts5(
          title,
          content,
          path UNINDEXED,
          content='inbox_items',
          content_rowid='id',
          tokenize='unicode61 remove_diacritics 2'
        );

        CREATE TRIGGER IF NOT EXISTS inbox_items_ai
        AFTER INSERT ON inbox_items BEGIN
          INSERT INTO inbox_fts(rowid, title, content, path)
          VALUES (new.id, coalesce(new.title, ''), new.content, new.path);
        END;

        CREATE TRIGGER IF NOT EXISTS inbox_items_ad
        AFTER DELETE ON inbox_items BEGIN
          INSERT INTO inbox_fts(inbox_fts, rowid, title, content, path)
          VALUES ('delete', old.id, coalesce(old.title, ''), old.content, old.path);
        END;

        CREATE TRIGGER IF NOT EXISTS inbox_items_au
        AFTER UPDATE ON inbox_items BEGIN
          INSERT INTO inbox_fts(inbox_fts, rowid, title, content, path)
          VALUES ('delete', old.id, coalesce(old.title, ''), old.content, old.path);
          INSERT INTO inbox_fts(rowid, title, content, path)
          VALUES (new.id, coalesce(new.title, ''), new.content, new.path);
        END;

        CREATE TABLE IF NOT EXISTS route_events (
          id INTEGER PRIMARY KEY,
          created_at TEXT NOT NULL,
          run_id TEXT NOT NULL,
          inbox_id INTEGER,
          route TEXT NOT NULL,
          decision TEXT NOT NULL,
          reason TEXT NOT NULL,
          payload_json TEXT NOT NULL
        );

        CREATE TABLE IF NOT EXISTS audit_events (
          id INTEGER PRIMARY KEY,
          created_at TEXT NOT NULL,
          run_id TEXT,
          level TEXT NOT NULL,
          event TEXT NOT NULL,
          message TEXT NOT NULL,
          meta_json TEXT NOT NULL
        );

        CREATE TABLE IF NOT EXISTS proposals (
          id INTEGER PRIMARY KEY,
          created_at TEXT NOT NULL,
          run_id TEXT NOT NULL,
          model TEXT,
          input_sha256 TEXT NOT NULL,
          proposal_path TEXT NOT NULL,
          status TEXT NOT NULL
        );
        """
    )

    con.execute(
        """
        INSERT OR REPLACE INTO loop_runs(
          run_id, started_at, repo, git_head, branch,
          git_dirty, hold_present, model, status, report_dir
        ) VALUES (
          ?, strftime('%Y-%m-%dT%H:%M:%fZ','now'), ?, ?, ?,
          ?, ?, ?, 'running', ?
        )
        """,
        (
            run_id,
            repo,
            head,
            branch,
            1 if dirty == "true" else 0,
            1 if hold == "true" else 0,
            model or None,
            run_dir,
        ),
    )

    con.execute(
        """
        INSERT INTO audit_events(
          created_at, run_id, level, event, message, meta_json
        ) VALUES (
          strftime('%Y-%m-%dT%H:%M:%fZ','now'),
          ?, 'info', 'run_started', 'local loop started', ?
        )
        """,
        (run_id, '{"mutation":false,"network_compute":false,"blockchain_compute":false}'),
    )

    con.commit()
finally:
    con.close()
PY

note "ingesting_lumo_inbox"

python3 - "$DB" "$RUN_ID" "$INBOX_DIR" "$MAX_INBOX_BYTES" <<'PY'
from pathlib import Path
import hashlib
import sqlite3
import sys

db, run_id, inbox_dir, max_bytes = sys.argv[1:]
root = Path(inbox_dir)
limit = int(max_bytes)

con = sqlite3.connect(db, timeout=10)
try:
    con.execute("PRAGMA busy_timeout=5000")
    ingested = 0
    skipped = 0

    for path in sorted(p for p in root.rglob("*") if p.is_file()):
        try:
            size = path.stat().st_size
            rel = str(path.relative_to(root))

            if size == 0 or size > limit:
                skipped += 1
                continue

            raw = path.read_bytes()
            if b"\x00" in raw:
                skipped += 1
                continue

            text = raw.decode("utf-8", errors="replace")
            digest = hashlib.sha256(raw).hexdigest()
            mtime = int(path.stat().st_mtime)
            title = text.splitlines()[0][:240] if text.splitlines() else rel

            previous = con.execute(
                "SELECT sha256 FROM inbox_items WHERE path=?",
                (rel,),
            ).fetchone()

            if previous and previous[0] == digest:
                skipped += 1
                continue

            con.execute(
                """
                INSERT INTO inbox_items(
                  path, sha256, bytes, mtime_epoch, ingested_at,
                  status, title, content, route, priority, run_id
                ) VALUES (
                  ?, ?, ?, ?, strftime('%Y-%m-%dT%H:%M:%fZ','now'),
                  'new', ?, ?, 'pending', 50, ?
                )
                ON CONFLICT(path) DO UPDATE SET
                  sha256=excluded.sha256,
                  bytes=excluded.bytes,
                  mtime_epoch=excluded.mtime_epoch,
                  ingested_at=excluded.ingested_at,
                  processed_at=NULL,
                  status='new',
                  title=excluded.title,
                  content=excluded.content,
                  route='pending',
                  priority=50,
                  run_id=excluded.run_id,
                  error_text=NULL
                """,
                (rel, digest, size, mtime, title, text, run_id),
            )
            ingested += 1
        except Exception:
            skipped += 1

    con.execute(
        """
        INSERT INTO audit_events(
          created_at, run_id, level, event, message, meta_json
        ) VALUES (
          strftime('%Y-%m-%dT%H:%M:%fZ','now'),
          ?, 'info', 'inbox_ingested', 'lumo inbox scan completed', ?
        )
        """,
        (run_id, f'{{"ingested":{ingested},"skipped":{skipped}}}'),
    )

    con.commit()
    print(f"ingested={ingested} skipped={skipped}")
finally:
    con.close()
PY

GIT_STATUS_FILE="$RUN_DIR/git_status.txt"
GIT_LOG_FILE="$RUN_DIR/git_log.txt"
PROCESS_FILE="$RUN_DIR/processes.txt"
MANIFEST_FILE="$RUN_DIR/hash_manifests.txt"
VALIDATION_FILE="$RUN_DIR/validation.txt"
GITHUB_FILE="$RUN_DIR/github.txt"

printf '%s\n' "$GIT_STATUS" > "$GIT_STATUS_FILE"
git log --oneline --decorate -n 25 > "$GIT_LOG_FILE" 2>&1 || true

ps -eo pid,ppid,etime,pcpu,pmem,stat,cmd \
  | grep -Ei '[o]llama|[l]lama-server|[b]ot_loop|[a]gent\.sh|[r]efine|[h]ash_assign|[p]ython.*openroot' \
  > "$PROCESS_FILE" || true

{
  for host in a15 optiplex; do
    manifest_db="$REPO/data/hash_manifest_${host}.db"
    pidfile="$REPO/run/hash_assign_${host}.pid"

    printf '%s\n' "--- host=$host ---"

    if [[ -r "$pidfile" ]]; then
      pid="$(cat "$pidfile" 2>/dev/null || true)"
      printf 'pidfile=%s pid=%s\n' "$pidfile" "$pid"
      if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        ps -p "$pid" -o pid,ppid,etime,pcpu,pmem,stat,cmd
      else
        printf '%s\n' 'worker=not-running'
      fi
    else
      printf '%s\n' 'pidfile=absent'
    fi

    if [[ -f "$manifest_db" ]]; then
      sqlite3 -noheader "$manifest_db" "
        SELECT
          'rows=' || COUNT(*)
          || ' ok=' || COALESCE(SUM(status='ok'),0)
          || ' errors=' || COALESCE(SUM(status='error'),0)
          || ' unique=' || COUNT(DISTINCT sha256)
          || ' latest=' || COALESCE(MAX(hashed_at),'none')
        FROM manifest;
      " 2>&1 || true
    else
      printf 'manifest_db=absent path=%s\n' "$manifest_db"
    fi
  done
} > "$MANIFEST_FILE"

{
  printf '%s\n' '=== Shell syntax ==='
  mapfile -d '' -t SH_FILES < <(git ls-files -z -- '*.sh')
  if ((${#SH_FILES[@]})); then
    for file in "${SH_FILES[@]}"; do
      bash -n "$file"
      printf 'PASS %s\n' "$file"
    done
  else
    printf '%s\n' 'No tracked shell files'
  fi

  printf '\n%s\n' '=== Python compile ==='
  mapfile -d '' -t PY_FILES < <(git ls-files -z -- '*.py')
  if ((${#PY_FILES[@]})); then
    PYTHONPYCACHEPREFIX="${TMPDIR:-/tmp}/openroot-pycache-$RUN_ID" \
      python3 -m compileall -q "${PY_FILES[@]}"
    printf '%s\n' 'compileall=PASS'
  else
    printf '%s\n' 'No tracked Python files'
  fi

  printf '\n%s\n' '=== Git diff check ==='
  git diff --check
  git diff --cached --check
  printf '%s\n' 'diff_check=PASS'
} > "$VALIDATION_FILE" 2>&1 || true

if command -v gh >/dev/null 2>&1; then
  {
    printf '%s\n' '=== GitHub CLI state ==='
    gh auth status 2>&1 || true
    printf '\n%s\n' '=== Repository ==='
    gh repo view --json nameWithOwner,url,defaultBranchRef,isPrivate 2>&1 || true
    printf '\n%s\n' '=== Recent workflow runs ==='
    gh run list --limit 20 \
      --json databaseId,status,conclusion,workflowName,displayTitle,headBranch,headSha,url,updatedAt \
      2>&1 || true
  } > "$GITHUB_FILE"
else
  printf '%s\n' 'gh CLI not installed' > "$GITHUB_FILE"
fi

python3 - \
  "$EVIDENCE_JSON" \
  "$RUN_ID" \
  "$REPO" \
  "$HEAD" \
  "${BRANCH:-DETACHED}" \
  "$UPSTREAM" \
  "$GIT_DIRTY" \
  "$HOLD_PRESENT" \
  "$MODEL" \
  "$GIT_STATUS_FILE" \
  "$GIT_LOG_FILE" \
  "$PROCESS_FILE" \
  "$MANIFEST_FILE" \
  "$VALIDATION_FILE" \
  "$GITHUB_FILE" <<'PY'
from pathlib import Path
from datetime import datetime, timezone
import json
import sys

(
    output,
    run_id,
    repo,
    head,
    branch,
    upstream,
    dirty,
    hold,
    model,
    git_status,
    git_log,
    processes,
    manifests,
    validation,
    github,
) = sys.argv[1:]

def read(path, limit=160000):
    return Path(path).read_text(encoding="utf-8", errors="replace")[:limit]

payload = {
    "schema": "openroot.evidence.v2",
    "generated_at": datetime.now(timezone.utc).isoformat(),
    "run_id": run_id,
    "repo": repo,
    "git": {
        "head": head,
        "branch": branch,
        "upstream": upstream or None,
        "dirty": dirty == "true",
        "status": read(git_status),
        "recent_commits": read(git_log),
    },
    "controls": {
        "human_hold_present": hold == "true",
        "mutation_allowed": False,
        "network_compute_allowed": False,
        "blockchain_compute_allowed": False,
    },
    "local_model": {
        "requested_model": model or None,
        "remote_api_allowed": False,
    },
    "runtime": {
        "processes": read(processes),
        "hash_manifests": read(manifests),
    },
    "validation": {
        "output": read(validation),
    },
    "github": {
        "read_only_snapshot": read(github),
    },
}

Path(output).write_text(
    json.dumps(payload, indent=2, sort_keys=True) + "\n",
    encoding="utf-8",
)
PY

python3 - \
  "$DB" \
  "$RUN_ID" \
  "$TASKS_JSON" \
  "$ROUTES_JSON" \
  "$MAX_TASKS" \
  "$GIT_DIRTY" \
  "$HOLD_PRESENT" <<'PY'
from pathlib import Path
import json
import sqlite3
import sys

db, run_id, tasks_path, routes_path, max_tasks, dirty, hold = sys.argv[1:]
limit = int(max_tasks)

con = sqlite3.connect(db, timeout=10)
con.row_factory = sqlite3.Row

try:
    con.execute("PRAGMA busy_timeout=5000")

    rows = con.execute(
        """
        SELECT id, path, title, content, priority
        FROM inbox_items
        WHERE status IN ('new', 'queued')
        ORDER BY priority DESC, id ASC
        LIMIT ?
        """,
        (limit,),
    ).fetchall()

    tasks = []
    routes = []

    for row in rows:
        source = f"{row['title']}\n{row['content']}".lower()

        if any(term in source for term in (
            "secret", "token", "api key", "password",
            "private key", "seed phrase", "wallet key"
        )):
            route = "quarantine"
            allowed = False
            priority = 100
            reason = "sensitive-term route"

        elif any(term in source for term in (
            "commit", "push", "merge", "delete",
            "rm -rf", "restart", "kill ", "deploy",
            "workflow run", "blockchain transaction",
            "wallet", "sign transaction", "bridge funds"
        )):
            route = "human_gate"
            allowed = False
            priority = 95
            reason = "mutation or external-action route"

        elif any(term in source for term in (
            "error", "failure", "traceback", "test",
            "bug", "ci", "github action"
        )):
            route = "repair_analysis"
            allowed = True
            priority = 85
            reason = "local repair analysis"

        elif any(term in source for term in (
            "sqlite", "fts", "fts5", "manifest",
            "ledger", "cache", "index", "hash"
        )):
            route = "local_data_analysis"
            allowed = True
            priority = 75
            reason = "local data analysis"

        elif any(term in source for term in (
            "readme", "docs", "documentation",
            "architecture", "design"
        )):
            route = "documentation"
            allowed = True
            priority = 65
            reason = "documentation analysis"

        else:
            route = "local_reasoning"
            allowed = True
            priority = 50
            reason = "general local reasoning"

        if dirty == "true" and route == "repair_analysis":
            reason += "; repository dirty: plan only"

        if hold == "true" and route == "human_gate":
            reason += "; human hold present"

        state = "queued" if allowed else "held"

        con.execute(
            """
            UPDATE inbox_items
            SET route=?, priority=?, status=?
            WHERE id=?
            """,
            (route, priority, state, row["id"]),
        )

        event = {
            "inbox_id": row["id"],
            "path": row["path"],
            "route": route,
            "allowed_for_local_proposal": allowed,
            "priority": priority,
            "reason": reason,
        }

        con.execute(
            """
            INSERT INTO route_events(
              created_at, run_id, inbox_id, route,
              decision, reason, payload_json
            ) VALUES (
              strftime('%Y-%m-%dT%H:%M:%fZ','now'),
              ?, ?, ?, ?, ?, ?
            )
            """,
            (
                run_id,
                row["id"],
                route,
                "allowed" if allowed else "held",
                reason,
                json.dumps(event, sort_keys=True),
            ),
        )

        tasks.append(
            {
                "id": row["id"],
                "path": row["path"],
                "title": row["title"],
                "route": route,
                "priority": priority,
                "allowed_for_local_proposal": allowed,
                "reason": reason,
                "content": row["content"][:12000],
            }
        )

        routes.append(event)

    con.commit()

    Path(tasks_path).write_text(
        json.dumps({"run_id": run_id, "tasks": tasks}, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )

    Path(routes_path).write_text(
        json.dumps({"run_id": run_id, "routes": routes}, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )

finally:
    con.close()
PY

python3 - \
  "$PACKET_MD" \
  "$RUN_ID" \
  "$HEAD" \
  "${BRANCH:-DETACHED}" \
  "$GIT_DIRTY" \
  "$HOLD_PRESENT" \
  "$MODEL" \
  "$EVIDENCE_JSON" \
  "$TASKS_JSON" \
  "$ROUTES_JSON" <<'PY'
from pathlib import Path
import sys

(
    packet_path,
    run_id,
    head,
    branch,
    dirty,
    hold,
    model,
    evidence_path,
    tasks_path,
    routes_path,
) = sys.argv[1:]

evidence = Path(evidence_path).read_text(encoding="utf-8", errors="replace")
tasks = Path(tasks_path).read_text(encoding="utf-8", errors="replace")
routes = Path(routes_path).read_text(encoding="utf-8", errors="replace")

packet = f"""# OpenRoot Lumo local packet

- Run: `{run_id}`
- HEAD: `{head}`
- Branch: `{branch}`
- Git dirty: `{dirty}`
- Human hold: `{hold}`
- Requested local model: `{model or "none"}`
- Mutation: forbidden
- Network compute: forbidden
- Blockchain, wallet, signing, bridge, mining, token, transaction, and peer-to-peer operations: forbidden

## Required response

1. Evidence-backed findings
2. Highest-value bounded next task
3. Files likely to change
4. Exact validation plan
5. Risks and stop conditions
6. Human approval required before any mutation: yes/no

## Constraints

Use only the packet evidence.
Do not claim missing facts.
Do not edit files.
Do not stage, commit, push, merge, deploy, restart, kill, dispatch workflows, use a remote API, or use blockchain infrastructure.
If evidence is insufficient, recommend read-only inspection only.

## Tasks

```json
{tasks}
```

## Route decisions

```json
{routes}
```

## Evidence

```json
{evidence}
```
"""

Path(packet_path).write_text(packet, encoding="utf-8")
PY

if [[ -z "$MODEL" ]]; then
  cat > "$PROPOSAL_MD" <<'EOF_PROPOSAL'
# OpenRoot local proposal

No local model was selected.

Run this script again only after checking installed models:

```bash
ollama list
MODEL='exact-local-model-name' /home/jesse/openroot/bin/openroot_local_loop_v2.sh
```

No mutation was performed.
EOF_PROPOSAL

elif ! command -v ollama >/dev/null 2>&1; then
  cat > "$PROPOSAL_MD" <<'EOF_PROPOSAL'
# OpenRoot local proposal unavailable

The `ollama` command is unavailable.

No mutation was performed.
EOF_PROPOSAL

elif ! ollama list | awk 'NR > 1 {print $1}' | grep -Fxq "$MODEL"; then
  cat > "$PROPOSAL_MD" <<EOF_PROPOSAL
# OpenRoot local proposal unavailable

The requested local model is not installed:

\`$MODEL\`

Run:

\`\`\`bash
ollama list
\`\`\`

No mutation was performed.
EOF_PROPOSAL

else
  python3 - \
    "$MODEL" \
    "$PACKET_MD" \
    "$PROPOSAL_MD" <<'PY'
from pathlib import Path
import json
import sys
import urllib.request

model, packet_path, proposal_path = sys.argv[1:]
packet = Path(packet_path).read_text(encoding="utf-8", errors="replace")

payload = json.dumps(
    {
        "model": model,
        "prompt": packet,
        "stream": False,
        "options": {
            "temperature": 0.2,
            "top_p": 0.9,
            "num_predict": 2400,
        },
    }
).encode("utf-8")

request = urllib.request.Request(
    "http://127.0.0.1:11434/api/generate",
    data=payload,
    headers={"Content-Type": "application/json"},
    method="POST",
)

try:
    with urllib.request.urlopen(request, timeout=240) as response:
        result = json.loads(response.read().decode("utf-8", errors="replace"))

    answer = str(result.get("response", "")).strip()

    if not answer:
        raise RuntimeError("empty response from local Ollama model")

    Path(proposal_path).write_text(
        "# OpenRoot local model proposal\n\n" + answer + "\n",
        encoding="utf-8",
    )

except Exception as exc:
    Path(proposal_path).write_text(
        "# OpenRoot local model proposal failed\n\n"
        f"`{type(exc).__name__}: {exc}`\n\n"
        "No mutation was performed.\n",
        encoding="utf-8",
    )
PY
fi

python3 - \
  "$DB" \
  "$RUN_ID" \
  "$MODEL" \
  "$PACKET_MD" \
  "$PROPOSAL_MD" \
  "$EVIDENCE_JSON" \
  "$TASKS_JSON" <<'PY'
from pathlib import Path
import hashlib
import sqlite3
import sys

db, run_id, model, packet, proposal, evidence, tasks = sys.argv[1:]

packet_hash = hashlib.sha256(
    Path(packet).read_bytes()
).hexdigest()

con = sqlite3.connect(db, timeout=10)
try:
    con.execute("PRAGMA busy_timeout=5000")

    con.execute(
        """
        INSERT INTO proposals(
          created_at, run_id, model,
          input_sha256, proposal_path, status
        ) VALUES (
          strftime('%Y-%m-%dT%H:%M:%fZ','now'),
          ?, ?, ?, ?, 'generated'
        )
        """,
        (run_id, model or None, packet_hash, proposal),
    )

    con.execute(
        """
        UPDATE inbox_items
        SET status='processed',
            processed_at=strftime('%Y-%m-%dT%H:%M:%fZ','now')
        WHERE run_id=?
          AND status='queued'
        """,
        (run_id,),
    )

    con.execute(
        """
        UPDATE loop_runs
        SET finished_at=strftime('%Y-%m-%dT%H:%M:%fZ','now'),
            status='complete',
            evidence_json=?,
            tasks_json=?,
            proposal_path=?
        WHERE run_id=?
        """,
        (evidence, tasks, proposal, run_id),
    )

    con.execute(
        """
        INSERT INTO audit_events(
          created_at, run_id, level, event, message, meta_json
        ) VALUES (
          strftime('%Y-%m-%dT%H:%M:%fZ','now'),
          ?, 'info', 'run_complete',
          'local loop complete without mutation',
          '{"mutation":false,"network_compute":false,"blockchain_compute":false}'
        )
        """,
        (run_id,),
    )

    con.commit()
finally:
    con.close()
PY

python3 - \
  "$SUMMARY_JSON" \
  "$RUN_ID" \
  "$REPO" \
  "$HEAD" \
  "${BRANCH:-DETACHED}" \
  "$GIT_DIRTY" \
  "$HOLD_PRESENT" \
  "$MODEL" \
  "$DB" \
  "$EVIDENCE_JSON" \
  "$TASKS_JSON" \
  "$ROUTES_JSON" \
  "$PACKET_MD" \
  "$PROPOSAL_MD" <<'PY'
from pathlib import Path
from datetime import datetime, timezone
import json
import sys

(
    output,
    run_id,
    repo,
    head,
    branch,
    dirty,
    hold,
    model,
    db,
    evidence,
    tasks,
    routes,
    packet,
    proposal,
) = sys.argv[1:]

summary = {
    "schema": "openroot.local_loop.v2",
    "generated_at": datetime.now(timezone.utc).isoformat(),
    "run_id": run_id,
    "repo": repo,
    "head": head,
    "branch": branch,
    "git_dirty": dirty == "true",
    "human_hold_present": hold == "true",
    "mutation_performed": False,
    "network_compute_used": False,
    "blockchain_compute_used": False,
    "model": model or None,
    "database": db,
    "artifacts": {
        "evidence": evidence,
        "tasks": tasks,
        "routes": routes,
        "packet": packet,
        "proposal": proposal,
    },
}

Path(output).write_text(
    json.dumps(summary, indent=2, sort_keys=True) + "\n",
    encoding="utf-8",
)
PY

chmod 600 \
  "$DB" \
  "$EVIDENCE_JSON" \
  "$TASKS_JSON" \
  "$ROUTES_JSON" \
  "$PACKET_MD" \
  "$PROPOSAL_MD" \
  "$SUMMARY_JSON"

printf '\n'
printf '%s\n' '# [OPENROOT_LOCAL_LOOP_V2]'
printf '%s\n' "[run]=$RUN_ID"
printf '%s\n' "[report_dir]=$RUN_DIR"
printf '%s\n' "[database]=$DB"
printf '%s\n' "[evidence]=$EVIDENCE_JSON"
printf '%s\n' "[tasks]=$TASKS_JSON"
printf '%s\n' "[routes]=$ROUTES_JSON"
printf '%s\n' "[packet]=$PACKET_MD"
printf '%s\n' "[proposal]=$PROPOSAL_MD"
printf '%s\n' "[summary]=$SUMMARY_JSON"
printf '%s\n' "[git_dirty]=$GIT_DIRTY"
printf '%s\n' "[human_hold]=$HOLD_PRESENT"
printf '%s\n' '[mutation]=none'
printf '%s\n' '[network_compute]=none'
printf '%s\n' '[blockchain_compute]=none'
printf '%s\n' '[exit=0]'
