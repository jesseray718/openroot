#!/bin/bash
echo "=== ACRE ENERGY DASHBOARD ==="
echo ""

# Totals
TOTAL_ACRE=$(jq -s '[.[].acre_minted] | add' acre/LEDGER.jsonl)
TOTAL_J=$(jq -s '[.[].energy_joules] | add' acre/LEDGER.jsonl)
ENTRIES=$(jq -s 'length' acre/LEDGER.jsonl)
THERMAL=$(jq -s '[.[] | select(.work_type | contains("thermal"))] | length' acre/LEDGER.jsonl)
COMPUTE=$(jq -s '[.[] | select(.work_type | contains("computation"))] | length' acre/LEDGER.jsonl)

echo "Supply: ${TOTAL_ACRE} ACRE | ${TOTAL_J} J total | ${ENTRIES} entries"
echo "Sources: thermal=${THERMAL} | computation=${COMPUTE}"
echo ""

echo "WORK TYPE BREAKDOWN:"
jq -sr '
  group_by(.work_type) | .[] |
  "\(.[0].work_type): \([.[].acre_minted]|add) ACRE | \([.[].energy_joules]|add) J | \(length) entries"
' acre/LEDGER.jsonl
echo ""

echo "LANDAUER INDEX (computation entries only):"
jq -sr '
  [.[] | select(.work_type | contains("computation"))] |
  if length > 0 then
    .[] |
    "  \(.entry_id): \(.landauer_efficiency)x above Landauer | \(.joules_per_bit) J/bit | recoverable=\(.reversible_recovery_potential)"
  else
    "  (none)"
  end
' acre/LEDGER.jsonl
echo ""

echo "REVERSIBLE GATE SAVINGS (latest compute entry):"
LAST_BITS=$(jq -sr 'last | .bits_processed // 0' acre/LEDGER.jsonl)
LAST_J=$(jq -sr 'last | .energy_joules // 0' acre/LEDGER.jsonl)
if command -v python3 &>/dev/null && ((LAST_BITS > 0)); then
  python3 bin/reversible_sim.py "$LAST_BITS" "$LAST_J" 2>/dev/null | grep -E "Energy saved|ACRE credit|recovery"
fi
echo ""

echo "CHAIN: $(verify-chain acre/LEDGER.jsonl 2>&1 | grep STATUS)"
echo "OTS stamps: $(ls .ots/*.ots 2>/dev/null | wc -l)"
