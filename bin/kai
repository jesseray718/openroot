#!/data/data/com.termux/files/usr/bin/python3
"""
Kai Groq CLI - Local wrapper for Groq's Llama 70B
Tracks 200k tokens per 30 minutes (rolling window)
"""

import os
import sys
import json
import time
from datetime import datetime, timedelta
from pathlib import Path

try:
    import requests
except ImportError:
    print("Error: requests library not found. Install with: pip install requests")
    sys.exit(1)

GROQ_API_KEY = os.getenv("GROQ_API_KEY")
MODEL = "llama-3.3-70b-versatile"
API_URL = "https://api.groq.com/openai/v1/chat/completions"
RATE_LIMIT = 200_000
WINDOW_MINUTES = 30

OPENROOT = Path.home() / "openroot"
TOKENS_FILE = OPENROOT / ".tokens_log"

def load_token_history():
    """Load recorded token usage from the last 30 minutes."""
    if not TOKENS_FILE.exists():
        return []
    try:
        with open(TOKENS_FILE, 'r') as f:
            history = json.load(f)
        cutoff = datetime.now() - timedelta(minutes=WINDOW_MINUTES)
        recent = [
            (ts, tokens)
            for ts, tokens in history
            if datetime.fromisoformat(ts) > cutoff
        ]
        return recent
    except (json.JSONDecodeError, ValueError):
        return []

def save_token_usage(tokens_used):
    """Log token usage with timestamp."""
    history = load_token_history()
    history.append((datetime.now().isoformat(), tokens_used))
    with open(TOKENS_FILE, 'w') as f:
        json.dump(history, f)

def get_token_usage():
    """Calculate total tokens used in the rolling 30-min window."""
    history = load_token_history()
    return sum(tokens for _, tokens in history)

def check_rate_limit():
    """Check current usage and warn if near limit."""
    used = get_token_usage()
    remaining = RATE_LIMIT - used
    percent = (used / RATE_LIMIT) * 100

    if remaining <= 0:
        print(f"⛔ RATE LIMIT EXCEEDED ({used:,} / {RATE_LIMIT:,} tokens)")
        print(f"⏳ Window resets in 30 minutes. Waiting...")
        time.sleep(1800)
        return True

    if percent > 80:
        print(f"⚠️  WARNING: {percent:.1f}% of limit used ({used:,} / {RATE_LIMIT:,})")
        print(f"   Remaining: {remaining:,} tokens | Resets in ~30 min\n")

    return False

def call_groq(prompt):
    """Make API call to Groq and return response + token usage."""
    if not GROQ_API_KEY:
        print("Error: GROQ_API_KEY environment variable not set")
        sys.exit(1)

    headers = {
        "Authorization": f"Bearer {GROQ_API_KEY}",
        "Content-Type": "application/json"
    }

    payload = {
        "model": MODEL,
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0.7,
        "max_tokens": 2048,
        "stream": False
    }

    try:
        response = requests.post(API_URL, json=payload, headers=headers, timeout=30)
        response.raise_for_status()
        data = response.json()

        reply = data["choices"][0]["message"]["content"]
        usage = data.get("usage", {})
        prompt_tokens = usage.get("prompt_tokens", 0)
        completion_tokens = usage.get("completion_tokens", 0)
        total_tokens = prompt_tokens + completion_tokens

        return reply, total_tokens

    except requests.exceptions.ConnectionError:
        print("❌ Connection error: Check internet and Groq API status")
        sys.exit(1)
    except requests.exceptions.HTTPError as e:
        if response.status_code == 429:
            print("⛔ API Rate limited by Groq (429)")
        else:
            print(f"❌ API Error: {response.status_code}")
            print(response.text)
        sys.exit(1)
    except Exception as e:
        print(f"❌ Error: {e}")
        sys.exit(1)

def main():
    if len(sys.argv) < 2:
        print("Usage: kai \"your prompt here\"")
        sys.exit(1)

    prompt = " ".join(sys.argv[1:])

    print("=== Kai (Groq Llama 70B) ===")

    if check_rate_limit():
        main()
        return

    print(f"📤 Sending prompt...\n")

    reply, tokens_used = call_groq(prompt)

    save_token_usage(tokens_used)

    print(reply)
    print(f"\n📊 Tokens used: {tokens_used:,}")

    used = get_token_usage()
    remaining = RATE_LIMIT - used
    percent = (used / RATE_LIMIT) * 100

    print(f"📈 Window usage: {used:,} / {RATE_LIMIT:,} ({percent:.1f}%)")
    print(f"⏱️  Remaining: {remaining:,} tokens (30-min rolling window)")

if __name__ == "__main__":
    main()
