#!/usr/bin/env bash
set -euo pipefail
cd $HOME/openroot || { echo "FATAL: $HOME/openroot missing"; exit 1; }

# 1. Local pre-review gate (CLI if present — closes the human loop before network)
if command -v coderabbit >/dev/null 2>&1; then
  echo "=== local CodeRabbit pre-push review ==="
  coderabbit review --uncommitted --include-untracked || true
  echo "=== local review complete ==="
else
  echo "NOTE: coderabbit CLI not installed — skipping local review (install later with curl -fsSL https://cli.coderabbit.ai/install.sh | sh)"
fi

# 2. Status + stage
git status -sb
git add -A
if git diff --cached --quiet; then
  echo "Nothing to commit. Clean lattice."
  exit 0
fi

# 3. Conventional commit with η timestamp
MSG="${1:-sync: $(date +%Y%m%d-%H%M) η-closed-loop}"
git commit -m "$MSG"

# 4. Push (SSH preferred, gh as fallback)
if git remote get-url origin 2>/dev/null | grep -q 'git@'; then
  git push origin HEAD
else
  gh auth status >/dev/null 2>&1 && gh repo sync || git push origin HEAD
fi

echo "=== pushed. CodeRabbit App will review on next PR. Mesh will sync via Syncthing. ==="
