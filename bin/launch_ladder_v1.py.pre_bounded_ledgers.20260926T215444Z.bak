#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-only
"""
launch_ladder_v1.py -- [LADDERV1] v2.1 WITH AUTONOMY MIGRATION
Success-gated stage launcher with progressive autonomy. Human-only stages can be
acknowledged (manual verify) OR upgraded to auto-verify as instrumentation matures.
Each stage tracks maturity_level (human|hybrid|auto). Upgrades unlock self-propelling
runs without manual intervention.

Doctrine: Endure proof before promotion. Guarantee = all instrumented checks green.
Auto-trigger fires next calibration on verified success, never the full run.
Human is the only commit gate; destructive ops require CONFIRM=1.
"""
import argparse, os, sqlite3, subprocess, sys, glob
from datetime import datetime, timezone
from pathlib import Path

CANARY = "[LADDERV1]"
OR = Path("/home/jesse/openroot")
DB = OR / "data" / "launch_ladder.db"
MISTAKE_ENGINE = OR / "bin" / "mistake_engine_v1.py"

def now(): return datetime.now(timezone.utc).isoformat(timespec="seconds")

def sh(cmd, timeout=600, cwd=str(OR)):
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True,
                           timeout=timeout, cwd=cwd)
        return r.returncode == 0, (r.stdout + r.stderr).strip()[-500:]
    except subprocess.TimeoutExpired:
        return False, f"TIMEOUT({timeout}s): {cmd[:80]}"

# ---------------------------------------------------------------------------
# STAGE REGISTRY: EACH HAS maturity_level TRACKER
#   human   = requires explicit 'ladder acknowledge <stage>' to advance
#   hybrid  = auto-calibrate, but full run needs manual trigger
#   auto    = full self-propelling chain (next calibration fires on verified)
# ---------------------------------------------------------------------------
STAGES = [
    {
        "name": "tooling_green",
        "desc": "every bin/*.py compiles + all canaries present",
        "maturity": "auto",
        "checks": [
            "for f in bin/*.py; do python3 -m py_compile \"$f\" || exit 1; done",
            "grep -l 'A1COREV1\\|COMPOSTV1\\|HANDOFFV1\\|LADDERV1' bin/*.py",
        ],
        "calib": {"cmd": "python3 -m py_compile bin/a1_core_v1.py && echo TOOLING_CALIB_OK", "timeout": 30},
        "runner": {"cmd": "python3 bin/a1_core_v1.py check-bin", "timeout": 120},
    },
    {
        "name": "mistake_engine_ready",
        "desc": "mistake→solution hash pairing active",
        "maturity": "auto",  # UPGRADED: now has real runner instead of echo
        "checks": [
            "test -f bin/mistake_engine_v1.py",
            "python3 -m py_compile bin/mistake_engine_v1.py",
        ],
        "calib": {"cmd": "python3 bin/mistake_engine_v1.py list 2>&1 | head -5 || echo 'engine alive'", "timeout": 60},
        "runner": {"cmd": "python3 bin/mistake_engine_v1.py compost", "timeout": 60},
    },
    {
        "name": "vector_index_calibrated",
        "desc": "local Ollama-backed provenance-preserving vector index with bounded self-retrieval proof",
        "maturity": "auto",
        "checks": [
            "test -f bin/agape_vector_index.py",
            "python3 -m py_compile bin/agape_vector_index.py",
            "ollama list | grep -Fq 'nomic-embed-text'",
        ],
        "calib": {"cmd": "python3 bin/agape_vector_index.py --light-init 2>&1 | grep -Fq '[banked] vector calibration PASS'", "timeout": 120},
        "runner": {"cmd": "python3 bin/agape_vector_index.py --query 'prepare semantic search query for Goals.md' --limit 3", "timeout": 120},
    },
    {
        "name": "ledgers_green",
        "desc": "universal doc ledger + compost pipeline real scan (bounded)",
        "maturity": "auto",
        "checks": [
            "test -f data/universal_doc_ledger.db",
            "python3 -m py_compile bin/a1_core_v1.py bin/compost_v1.py",
        ],
        "calib": {"cmd": "python3 bin/a1_core_v1.py check-bin", "timeout": 120},
        "runner": {"cmd": "python3 bin/a1_core_v1.py scan && python3 bin/compost_v1.py rank", "timeout": 3600},
    },
    {
        "name": "handoff_operational",
        "desc": "session continuity + goals persistence + tidbit chunking",
        "maturity": "auto",
        "checks": [
            "python3 bin/handoff_manager.py show",
            "test -f context_bridge/session_ledger.db",
        ],
        "calib": {"cmd": "python3 bin/handoff_manager.py start", "timeout": 120},
        "runner": {"cmd": "python3 bin/handoff_manager.py end", "timeout": 120},
    },
    {
        "name": "contributor_seal",
        "desc": "Reh1t PR #53 resolved with credit — goodwill is scarcest asset",
        "maturity": "human",  # TRUE human-only: judgment cannot be automated
        "checks": ['gh pr view 53 --repo jesseray718/openroot --json state -q .state | grep -qi merged'],
        "calib": {"cmd": "gh pr view 53 --repo jesseray718/openroot --json state,author,title", "timeout": 60},
        "runner": {"cmd": "echo '[gate] PR 53 merge is HUMAN-ADJUDICATED'", "timeout": 60, "human_only": True},
    },
    {
        "name": "first_release",
        "desc": "aerocement-panel-v0 standalone repo with BOM + build evidence",
        "maturity": "hybrid",  # auto-checks, human gates publish
        "checks": ["test -d aerocement-panel-v0 || gh repo list jesseray718 --limit 20 | grep -q aerocement"],
        "calib": {"cmd": "python3 bin/a1_core_v1.py route --task 'draft README for aerocement panel BOM'", "timeout": 60},
        "runner": {"cmd": "echo '[gate] finalize README + gh release create'", "timeout": 120, "human_only": True},
    },
    {
        "name": "public_face",
        "desc": "profile pinned repos + README photo slot + stranger-readable front page",
        "maturity": "human",  # identity-level judgment
        "checks": ["test -s README.md && grep -qi 'aerocement\\|OpenCell\\|agape' README.md"],
        "calib": {"cmd": "grep -ci 'four engines\\|openroot' README.md", "timeout": 30},
        "runner": {"cmd": "echo '[gate] pin 4 repos + insert [PHOTO] via gh'", "timeout": 60, "human_only": True},
    },
]

def connect():
    con = sqlite3.connect(str(DB))
    con.executescript("""
    CREATE TABLE IF NOT EXISTS stages(
      name TEXT PRIMARY KEY, status TEXT DEFAULT 'locked',
      maturity TEXT DEFAULT 'human', checks_ok INTEGER DEFAULT 0, attempts INTEGER DEFAULT 0,
      last_action TEXT, last_ts TEXT, evidence TEXT);
    """)
    for s in STAGES:
        con.execute("INSERT INTO stages(name, maturity) VALUES(?, ?) ON CONFLICT(name) DO UPDATE SET maturity=excluded.maturity", (s["name"], s["maturity"]))
    con.commit()
    return con

def stage_idx(name): return next(i for i, s in enumerate(STAGES) if s["name"] == name)

def prior_verified(con, idx):
    return idx == 0 or con.execute(
        "SELECT status FROM stages WHERE name=?", (STAGES[idx-1]["name"],)
    ).fetchone()[0] == "verified"

def report_mistake(con, stage, detail):
    try:
        con.execute("UPDATE stages SET status='failed', evidence=?, last_ts=? WHERE name=?",
                    (detail[:400], now(), stage))
        con.commit()
    except sqlite3.Error:
        pass

def run_checks(con, st):
    for chk in st["checks"]:
        ok, out = sh(chk, timeout=120)
        if not ok:
            return False, f"CHECK FAILED: {chk[:100]} | {out}"
    return True, "all checks green"

def calibrate(con, st):
    ok, out = sh(st["calib"]["cmd"], timeout=st["calib"]["timeout"])
    if not ok:
        report_mistake(con, st["name"], f"calibration: {out}"); return False
    con.execute("UPDATE stages SET status='calibrated', last_action='calibration PASSED (real, bounded)', "
                "last_ts=?, evidence=? WHERE name=?", (now(), out[:200], st["name"]))
    con.commit()
    print(f"[banked] calibration PASSED → {st['name']} promoted to CALIBRATED")
    return True

def run_stage(con, st):
    r = st["runner"]
    if r.get("destructive") and os.environ.get("CONFIRM") != "1":
        print("[held] destructive runner requires CONFIRM=1"); return False
    if r.get("human_only"):
        print(f"[gate] {r['cmd']}")
        print(f"[acknowledge] Stage requires manual verification. Run `ladder acknowledge {st['name']}` after completing work.")
        return False
    ok, out = sh(r["cmd"], timeout=r["timeout"])
    if not ok:
        report_mistake(con, st["name"], f"runner: {out}"); return False
    ok2, ev = run_checks(con, st)
    if not ok2:
        report_mistake(con, st["name"], ev); return False
    con.execute("UPDATE stages SET status='verified', checks_ok=1, last_action='run+verify GREEN', "
                "last_ts=?, evidence=? WHERE name=?", (now(), ev[:200], st["name"]))
    con.commit()
    print(f"[banked] {st['name']} VERIFIED GREEN — success endured")
    # AUTO-TRIGGER next calibration
    nxt = stage_idx(st["name"]) + 1
    if nxt < len(STAGES):
        ns = STAGES[nxt]
        if prior_verified(con, nxt):
            print(f"[auto-trigger] → calibrating next stage: {ns['name']}")
            calibrate(con, ns)
    return True

def acknowledge_stage(con, stage_name):
    """Manual verification for human_only stages. Records timestamp + reason."""
    st = next((s for s in STAGES if s["name"] == stage_name), None)
    if not st:
        print(f"[held] unknown stage {stage_name}"); return False
    if st.get("maturity") not in ("human", "hybrid"):
        print(f"[held] stage {stage_name} is {st['maturity']}, no acknowledgment needed"); return False
    con.execute("UPDATE stages SET status='verified', last_action='manually acknowledged (human verified)', "
                "last_ts=?, maturity='hybrid' WHERE name=?", (now(), stage_name))
    con.commit()
    print(f"[banked] {stage_name} manually verified → maturity upgraded to hybrid")
    # Auto-trigger next
    nxt = stage_idx(stage_name) + 1
    if nxt < len(STAGES):
        ns = STAGES[nxt]
        if prior_verified(con, nxt):
            print(f"[auto-trigger] → calibrating next stage: {ns['name']}")
            calibrate(con, ns)
    return True

def upgrade_maturity(con, stage_name, new_maturity):
    """Promote a stage from human→hybrid→auto as instrumentation improves."""
    valid_levels = ("human", "hybrid", "auto")
    if new_maturity not in valid_levels:
        print(f"[held] invalid maturity: {new_maturity}"); return False
    con.execute("UPDATE stages SET maturity=? WHERE name=?", (new_maturity, stage_name))
    con.commit()
    print(f"[banked] {stage_name} maturity upgraded to {new_maturity}")

def status(con):
    print(f"{'stage':<22} {'status':<12} {'mat':<6} {'attempts'} desc")
    print("-"*110)
    for s in STAGES:
        row = con.execute("SELECT status, maturity, attempts FROM stages WHERE name=?", (s["name"],)).fetchone()
        mark = "***" if row[0] == "verified" else ("!" if row[0] == "failed" else "")
        print(f"{s['name']+mark:<25} {row[0]:<12} {row[1]:<6} {row[2]:<8} {s['desc'][:45]}")

def repair_quarantine():
    q = OR / "quarantine_handoff_corrupt"
    q.mkdir(exist_ok=True)
    bad = OR / "bin" / "handoff_manager.py"
    if bad.exists():
        stamp = now().replace(":", "")
        bad.rename(q / f"handoff_manager.py.corrupt.{stamp}")
        print(f"[banked] corrupted file moved to {q}")

def main():
    ap = argparse.ArgumentParser(description=CANARY + " v2.1 with autonomy migration")
    ap.add_argument("cmd", choices=["status", "calibrate", "run", "acknowledge", "upgrade", "repair"])
    ap.add_argument("stage", nargs="?", help="stage name")
    ap.add_argument("--maturity", default=None, help="new maturity level (human|hybrid|auto)")
    a = ap.parse_args()
    con = connect()
    if a.cmd == "status":
        status(con); print("[exit=0]"); return
    if a.cmd == "repair":
        repair_quarantine(); return
    if not a.stage:
        print("[held] specify stage; run `status` first"); sys.exit(1)
    st = next((s for s in STAGES if s["name"] == a.stage), None)
    if not st:
        print(f"[held] unknown stage {a.stage}"); sys.exit(1)
    idx = stage_idx(a.stage)
    if not prior_verified(con, idx):
        print(f"[held] gate closed: prior stage not VERIFIED"); sys.exit(1)
    if a.cmd == "acknowledge":
        acknowledge_stage(con, a.stage)
    elif a.cmd == "upgrade":
        if not a.maturity:
            print("[held] --maturity required"); sys.exit(1)
        upgrade_maturity(con, a.stage, a.maturity)
    elif a.cmd == "calibrate":
        ok, _ = run_checks(con, st)
        if ok: calibrate(con, st)
        else: print("[held] entry checks red — repair instruments first")
    elif a.cmd == "run":
        row = con.execute("SELECT status FROM stages WHERE name=?", (a.stage,)).fetchone()
        if row[0] not in ("calibrated", "verified", "failed"):
            print("[held] stage not calibrated yet: run `calibrate` first"); sys.exit(1)
        run_stage(con, st)
    print("[exit=0]")

if __name__ == "__main__":
    main()
