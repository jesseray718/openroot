#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
export PATH=/data/data/com.termux/files/usr/bin:$PATH

REPORT="/sdcard/openroot/master/last_run_report.md"
MASTER="/sdcard/openroot/master/permaculture_lattice_master.md"
LOGDIR="/sdcard/openroot/master/run_logs"
mkdir -p "$LOGDIR"
TS=$(date +%Y%m%d_%H%M%S)
LOG="$LOGDIR/run_$TS.log"
TMP=$(mktemp)

# 1. Grab last Grok response from clipboard
CLIP=$(termux-clipboard-get 2>/dev/null || true)
if [ -z "$CLIP" ]; then
  termux-toast "termics: clipboard empty"
  exit 1
fi

# 2. Extract ordered fenced blocks (bash / sh / python preferred)
python3 - "$CLIP" << 'PY' > "$TMP"
import sys, re
text = sys.argv[1]
# capture ```lang\n...\n``` in appearance order
blocks = re.findall(r'```(?:bash|sh|python|py)?\n(.*?)```', text, re.DOTALL)
for i, b in enumerate(blocks, 1):
    print(f"###BLOCK_{i}###")
    print(b.strip())
    print("###END###")
PY

if [ ! -s "$TMP" ]; then
  termux-toast "termics: no runnable blocks found"
  exit 1
fi

# 3. Execute sequentially, capture exit + last lines
{
  echo "# termics-run-last  $TS"
  echo "resonance: 1.0   η language active"
  echo
} > "$REPORT"

BLOCK_N=0
while IFS= read -r line; do
  if [[ "$line" == "###BLOCK_"* ]]; then
    BLOCK_N=$((BLOCK_N+1))
    BLOCK_FILE=$(mktemp)
    continue
  fi
  if [[ "$line" == "###END###" ]]; then
    echo "----- block $BLOCK_N -----" | tee -a "$LOG" >> "$REPORT"
    set +e
    # detect python vs shell
    if head -1 "$BLOCK_FILE" | grep -qE '^(import |from |#!/.*python|def |print\()'; then
      python3 "$BLOCK_FILE" > "$BLOCK_FILE.out" 2>&1
      EC=$?
    else
      bash "$BLOCK_FILE" > "$BLOCK_FILE.out" 2>&1
      EC=$?
    fi
    set -e
    echo "exit: $EC" | tee -a "$LOG" >> "$REPORT"
    # headline = last non-empty line or first error
    if [ $EC -eq 0 ]; then
      tail -n 5 "\( BLOCK_FILE.out" | grep -v '^ \)' | tail -1 | tee -a "$LOG" >> "$REPORT" || echo "(ok, no output)" >> "$REPORT"
    else
      echo "ERROR:" >> "$REPORT"
      tail -n 8 "$BLOCK_FILE.out" | tee -a "$LOG" >> "$REPORT"
    fi
    echo >> "$REPORT"
    cat "$BLOCK_FILE.out" >> "$LOG"
    rm -f "$BLOCK_FILE" "$BLOCK_FILE.out"
    continue
  fi
  echo "$line" >> "$BLOCK_FILE"
done < "$TMP"
rm -f "$TMP"

# 4. Final headline for quick feedback
HEADLINE=$(grep -E '^(exit:|ERROR:|vertex|η|Best |ok)' "$REPORT" | tail -3 | tr '\n' ' ' | cut -c1-90)
echo "SUMMARY: $HEADLINE" >> "$REPORT"

# 5. Stamp into master + put report on clipboard so you can paste straight back into floating Grok
{
  echo
  echo "## RUN $TS"
  cat "$REPORT"
} >> "$MASTER"

termux-clipboard-set < "$REPORT"
termux-toast "termics done  blocks=$BLOCK_N  $HEADLINE"
echo "$REPORT"
