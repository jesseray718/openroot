#!/bin/bash
# measure-drain: Estimate joules via battery discharge (requires Shizuku/aShell)
START_BAT=$(dumpsys battery | grep Level | awk '{print $3}' | tr -d '%')
START_VOLT=$(dumpsys battery | grep Voltage | awk '{print $3}' | tr -d 'mV')
START_TIME=$(date +%s)

# Run workload
sleep "${1:-60}"

END_BAT=$(dumpsys battery | grep Level | awk '{print $3}' | tr -d '%')
END_VOLT=$(dumpsys battery | grep Voltage | awk '{print $3}' | tr -d 'mV')
END_TIME=$(date +%s)

DELTA_BAT=$((START_BAT - END_BAT))
DELTA_TIME=$((END_TIME - START_TIME))
AVG_VOLT=$(((START_VOLT + END_VOLT) / 2))

# Joules = Ah × V × 3600 (simplified)
JOULES=$(awk "BEGIN{printf \"%.2f\", ($DELTA_BAT / 100.0) * 4.5 * 3600}")
ACRE_MINTED=$(awk "BEGIN{printf \"%.8f\", $JOULES / 1000}")

echo "[m] Battery: ${START_BAT}% → ${END_BAT}% (${DELTA_BAT}% over ${DELTA_TIME}s)"
echo "[m] Avg voltage: ${AVG_VOLT} mV"
echo "[m] Energy: ${JOULES} J"
echo "[m] ACRE: ${ACRE_MINTED}"
