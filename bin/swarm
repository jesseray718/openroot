#!/data/data/com.termux/files/usr/bin/bash
# swarm: voice command → routes to appropriate nanobot(s)
# Usage: swarm (then speak your intent)

DUR=10
C="$HOME/.cache/lumo"
mkdir -p "$C"
W="$C/mic-$$.wav"
T="$C/transcript.txt"

echo "🎙️ ${DUR}s — speak your intent (e.g. 'audit my repo and publish')"
termux-microphone-record -d -f "$W" -l "$DUR" 2>/dev/null
sleep $((DUR + 2))
ffmpeg -y -i "$W" -ar 16000 -ac 1 "$C/a16.wav" 2>/dev/null
source ~/.config/aiq/config.sh 2>/dev/null
curl -s https://api.groq.com/openai/v1/audio/transcriptions \
  -H "Authorization: Bearer $GROQ_API_KEY" \
  -F file="@$C/a16.wav" -F model="whisper-large-v3" 2>/dev/null | \
  jq -r '.text // empty' 2>/dev/null > "$T"
INTENT=$(cat "$T" | tr '[:upper:]' '[:lower:]')
echo "📝 Intent: ${INTENT:0:100}"

# Route based on keywords
if echo "$INTENT" | grep -qE 'audit|scan|deep|dive|inventory'; then
  echo "🐜 → deepdive"
  deepdive ~/projects/openroot
elif echo "$INTENT" | grep -qE 'publish|deploy|release|zenodo|ipfs'; then
  echo "🐜 → publish"
  publish ~/projects/openroot
elif echo "$INTENT" | grep -qE 'git|push|pull|conflict|merge|sync'; then
  echo "🐜 → git-fix"
  git-fix
elif echo "$INTENT" | grep -qE 'error|fix|broken|fail|bug'; then
  echo "🐜 → fix-it"
  fix-it
elif echo "$INTENT" | grep -qE 'document|note|axiom|postulate|hypothesis|save'; then
  echo "🐜 → une-scribe"
  une-scribe
elif echo "$INTENT" | grep -qE 'thermal|heat|cascade|carnot|stirling|temperature'; then
  echo "🐜 → therm-calc"
  therm-calc 20
elif echo "$INTENT" | grep -qE 'context|bridge|handoff|summary'; then
  echo "🐜 → ctx-bridge"
  ctx-bridge
elif echo "$INTENT" | grep -qE 'publish.*audit|audit.*publish'; then
  echo "🐜 SWARM: deepdive → publish"
  deepdive ~/projects/openroot
  echo "---"
  publish ~/projects/openroot
else
  echo "🐜 → vai (general AI)"
  vai 10
fi
rm -f "$W" "$C/a16.wav"
