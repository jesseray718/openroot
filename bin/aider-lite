#!/bin/bash
# aider-lite v5: Groq + Git + OTS + ACRE mint + Landauer efficiency
set -euo pipefail

GROQ_API_KEY="${GROQ_API_KEY:-$(cat ~/.config/groq/key 2>/dev/null || echo '')}"
MODEL="llama-3.3-70b-versatile"
ACRE_RATIO=1000
LEDGER="acre/LEDGER.jsonl"

# Landauer constants
BOLTZMANN=1.380649e-23
ROOM_TEMP=300
LANDAUER_J=$(awk "BEGIN{printf \"%.6e\", $BOLTZMANN * $ROOM_TEMP * 0.6931471805599453}")

[[ $# -lt 1 ]] && { echo 'Usage: aider-lite [--write] [--commit] [--ots] [--mint] "prompt" [files...]'; exit 1; }
[[ -z "$GROQ_API_KEY" ]] && { echo 'Set GROQ_API_KEY'; exit 1; }

WRITE=false; COMMIT=false; OTS=false; MINT=false
while [[ ${1:0:2} == "--" ]]; do
  case "$1" in
    --write) WRITE=true ;;
    --commit) COMMIT=true ;;
    --ots) OTS=true ;;
    --mint) MINT=true ;;
    *) ;;
  esac
  shift
done

PROMPT="$1"
shift
FILES=("$@")

CALL_START=$(date +%s%N)
CONTEXT=""
FILE_LIST=""
for f in "${FILES[@]:-}"; do
  [[ -z "$f" ]] && continue
  if [[ -f "$f" ]]; then
    CONTENT=$(cat "$f" 2>/dev/null)
    CONTEXT+="
=== FILE: $f ===
$CONTENT"
    FILE_LIST+=" $f"
  fi
done

if [[ ! -t 0 ]]; then
  STDIN=$(cat)
  [[ -n "$STDIN" ]] && CONTEXT+="
=== STDIN ===
$STDIN"
fi

ACTION="analyze only"
$WRITE && ACTION="OUTPUT THE COMPLETE MODIFIED FILE in a single code block"

PAYLOAD=$(jq -n --arg m "$MODEL" --arg p "$PROMPT" --arg c "$CONTEXT" --arg a "$ACTION" '{
  model:$m,
  messages:[
    {role:"system",content:"You are a code assistant. "+$a+". Keep changes minimal."},
    {role:"user",content:$p+"\n"+$c}
  ],
  max_tokens:4096,
  temperature:0.2
}')

echo "[>] Groq..."
RESPONSE=$(curl -s https://api.groq.com/openai/v1/chat/completions \
  -H "Authorization: Bearer $GROQ_API_KEY" \
  -H "Content-Type: application/json" \
  -d "$PAYLOAD")

CALL_END=$(date +%s%N)

if $MINT; then
  ELAPSED_NS=$((CALL_END - CALL_START))
  ELAPSED_S=$(awk "BEGIN{printf \"%.6f\", $ELAPSED_NS / 1000000000}")

  AVG_FREQ_MHZ=0
  for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq; do
    F=$(cat "$cpu" 2>/dev/null)
    if ((F > 0)); then
      AVG_FREQ_MHZ=$((F / 1000))
      break
    fi
  done
  if ((AVG_FREQ_MHZ == 0)); then
    AVG_FREQ_MHZ=2000
  fi

  AVG_CORES=8
  POWER_PER_CORE=$(awk "BEGIN{printf \"%.6f\", 0.001 * $AVG_FREQ_MHZ}")
  ENERGY_JOULES=$(awk "BEGIN{printf \"%.4f\", $POWER_PER_CORE * $AVG_CORES * $ELAPSED_S}")
  ACRE_MINTED=$(awk "BEGIN{printf \"%.8f\", $ENERGY_JOULES / $ACRE_RATIO}")

  # ─── LANDAUER ANALYSIS ─────────────────────────────────────
  # Estimate bits processed: tokens out × bits per token (~5 bytes/token)
  OUTPUT_TOKENS=$(echo "$RESPONSE" | jq -r '.usage.completion_tokens // 512')
  INPUT_TOKENS=$(echo "$RESPONSE" | jq -r '.usage.prompt_tokens // 0')
  TOTAL_TOKENS=$((OUTPUT_TOKENS + INPUT_TOKENS))
  BITS_PROCESSED=$((TOTAL_TOKENS * 40))

  # Landauer floor: minimum energy to erase that many bits
  LANDAUER_FLOOR=$(awk "BEGIN{printf \"%.6e\", $BITS_PROCESSED * $LANDAUER_J}")

  # Efficiency ratio: how far above Landauer (1.0 = at limit)
  EFFICIENCY_RATIO=$(awk "BEGIN{if ($LANDAUER_FLOOR > 0) printf \"%.4e\", $ENERGY_JOULES / $LANDAUER_FLOOR; else print \"inf\"}")

  # Reversibility coefficient: what fraction of energy could theoretically be recovered
  # if computation were fully reversible (Bennett's bound)
  REVERSIBLE_RECOVERABLE=$(awk "BEGIN{printf \"%.6f\", 1.0 - ($LANDAUER_FLOOR / $ENERGY_JOULES)}")

  # Energy per bit (actual)
  JOULES_PER_BIT=$(awk "BEGIN{printf \"%.6e\", $ENERGY_JOULES / $BITS_PROCESSED}")

  echo "[m] Energy: ${ENERGY_JOULES} J | ${AVG_FREQ_MHZ} MHz | ${AVG_CORES} cores | ${ELAPSED_S}s"
  echo "[m] ACRE: ${ACRE_MINTED} (ratio: ${ACRE_RATIO} J/ACRE)"
  echo "[m] Landauer: ${LANDAUER_FLOOR} J floor for ${BITS_PROCESSED} bits"
  echo "[m] Efficiency: ${EFFICIENCY_RATIO}x above Landauer | ${JOULES_PER_BIT} J/bit"
  echo "[m] Reversible recovery potential: ${REVERSIBLE_RECOVERABLE} (${REVERSIBLE_RECOVERABLE}% of energy)"
fi

TEXT=$(echo "$RESPONSE" | jq -r '.choices[0].message.content // empty')

if [[ -z "$TEXT" ]]; then
  echo "[!] No response"
  echo "$RESPONSE" | jq '.' 2>/dev/null || echo "$RESPONSE"
  exit 1
fi

CODE=$(echo "$TEXT" | sed -n '/```/,/^```/p' | sed '1d;$d')

if $WRITE && [[ -n "$CODE" && -n "$FILE_LIST" ]]; then
  TARGET=$(echo "$FILE_LIST" | awk '{print $1}')
  cp "$TARGET" "${TARGET}.bak.$(date +%s)" 2>/dev/null || true
  echo "$CODE" > "$TARGET"
  echo "[+] Written to $TARGET"

  if $COMMIT && git rev-parse --git-dir &>/dev/null; then
    git add "$TARGET"
    git commit -m "aider: $PROMPT" -q
    HASH=$(git rev-parse --short HEAD)
    FULL_HASH=$(git rev-parse HEAD)
    echo "[+] Committed: $HASH"

    OTS_RECEIPT=""
    if $OTS && command -v ots &>/dev/null; then
      mkdir -p .ots
      MERKLE="$FULL_HASH"
      for cf in $(git diff-tree --no-commit-id --name-only -r HEAD); do
        H=$(sha256sum "$cf" 2>/dev/null | awk '{print $1}')
        MERKLE+="$H"
      done
      ROOT=$(echo -n "$MERKLE" | sha256sum | awk '{print $1}')
      STAMP=".ots/${HASH}.txt"
      echo "$ROOT" > "$STAMP"
      echo "[>] ots: stamping..."
      ots stamp "$STAMP" 2>/dev/null
      RECEIPT="${STAMP}.ots"
      if [[ -f "$RECEIPT" ]]; then
        OTS_RECEIPT="$RECEIPT"
        echo "[+] OTS stamp: $RECEIPT"
        git tag -a "ots-${HASH}" -m "merkle=${ROOT:0:16}" 2>/dev/null || true
        jq -nc --arg h "$HASH" --arg r "$ROOT" --arg p "$PROMPT" --arg t "$(date -u +%FT%TZ)" \
          '{commit:$h,merkle:$r,prompt:$p,ts:$t}' >> .ots/manifest.jsonl
        echo "[+] Manifest updated"
      else
        echo "[!] Stamp failed"
      fi
    elif $OTS; then
      echo "[!] ots not found"
    fi

    if $MINT; then
      mkdir -p acre
      touch "$LEDGER"

      PREV_HASH="null"
      LAST_LINE=$(tail -1 "$LEDGER" 2>/dev/null)
      if [[ -n "$LAST_LINE" ]]; then
        PREV_HASH=$(echo -n "$LAST_LINE" | sha256sum | awk '{print $1}')
      fi

      TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      ENTRY_ID="comp_${HASH}_$(date -u +%Y%m%d%H%M%S)"
      UNE_CODE="DV.COMP.AI01"
      VALIDATORS='["AI_GROQ","OTS_BTC"]'
      [[ -z "$OTS_RECEIPT" ]] && VALIDATORS='["AI_GROQ"]'

      ENTRY=$(jq -nc \
        --arg eid "$ENTRY_ID" \
        --arg ts "$TIMESTAMP" \
        --arg ej "$ENERGY_JOULES" \
        --arg am "$ACRE_MINTED" \
        --arg ph "$PREV_HASH" \
        --argjson validators "$VALIDATORS" \
        --arg uc "$UNE_CODE" \
        --arg src "aider-lite" \
        --arg ch "$HASH" \
        --arg ots "$OTS_RECEIPT" \
        --arg p "$PROMPT" \
        --arg freq "$AVG_FREQ_MHZ" \
        --arg cores "$AVG_CORES" \
        --arg el "$ELAPSED_S" \
        --arg lf "$LANDAUER_FLOOR" \
        --arg bits "$BITS_PROCESSED" \
        --arg eff "$EFFICIENCY_RATIO" \
        --arg jpb "$JOULES_PER_BIT" \
        --arg rev "$REVERSIBLE_RECOVERABLE" \
        --arg tokens "$TOTAL_TOKENS" \
        '{
          entry_id: $eid,
          timestamp: $ts,
          work_type: "computation_aider_lite",
          energy_joules: ($ej|tonumber),
          acre_minted: ($am|tonumber),
          previous_hash: $ph,
          validators: $validators,
          une_code: $uc,
          source: $src,
          commit_hash: $ch,
          ots_receipt: $ots,
          prompt: $p,
          cpu_freq_mhz: ($freq|tonumber),
          cores: ($cores|tonumber),
          elapsed_s: ($el|tonumber),
          landauer_floor_j: ($lf|tonumber),
          bits_processed: ($bits|tonumber),
          tokens_processed: ($tokens|tonumber),
          landauer_efficiency: ($eff|tonumber),
          joules_per_bit: ($jpb|tonumber),
          reversible_recovery_potential: ($rev|tonumber)
        }')

      echo "$ENTRY" >> "$LEDGER"
      echo "[+] ACRE minted: ${ACRE_MINTED} → $LEDGER"
      echo "[+] Entry: $ENTRY_ID"
      echo "[+] Previous hash: ${PREV_HASH:0:16}..."
    fi

  fi
elif $WRITE && [[ -z "$CODE" ]]; then
  echo "[!] No code block in response"
  echo "$TEXT"
  exit 1
else
  echo "$TEXT"
fi
