[Unit]
Description=OpenRoot observer heartbeat (user)
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/jesse/openroot
Environment=OPENROOT_ROOT=/home/jesse/openroot
Environment=OPENROOT_OBSERVER_PERIOD=300
ExecStart=/usr/bin/python3 /home/jesse/openroot/tools/observer_infer.py /home/jesse/.bash_history
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
