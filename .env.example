# OpenRoot offline toolkit – environment configuration
# Copy this file to .env and adjust as needed.
# The offline toolkit works with all defaults; no values are required.

# ── Storage ────────────────────────────────────────────────────────────────
# Local data directory (defaults to ~/.openroot/offline)
# OFFLINE_DATA_DIR=/path/to/your/offline/data

# ── Data lifecycle ─────────────────────────────────────────────────────────
# Days a soft-deleted record is retained before becoming purge-eligible
OFFLINE_SOFT_DELETE_RETENTION_DAYS=30

# ── Priority scoring weights ────────────────────────────────────────────────
# Score = urgency^2 * impact * weight_urgency * weight_impact
OFFLINE_PRIORITY_WEIGHT_URGENCY=1.0
OFFLINE_PRIORITY_WEIGHT_IMPACT=1.0

# ── Thermal / resource regulation ──────────────────────────────────────────
# CPU % thresholds for concurrency throttling
OFFLINE_THERMAL_CPU_HIGH=80.0
OFFLINE_THERMAL_CPU_LOW=40.0
# Maximum parallel worker slots
OFFLINE_THERMAL_MAX_CONCURRENCY=4

# ── Sync endpoint ──────────────────────────────────────────────────────────
# Leave empty for fully offline operation.
# Set to your remote API URL to enable queue replay.
OFFLINE_SYNC_ENDPOINT=
