#!/usr/bin/env bash
# agape-ipfs v1.0.0 — local-first IPFS pin + SHA-256 ledger
# Author: Jesse Ray / OpenRoot
set -euo pipefail
VERSION="1.0.0"
LEDGER_DIR="${OPENROOT_LEDGER:-$HOME/openroot/agape_net/ledger}"
IPFS_DIR="${OPENROOT_IPFS:-$HOME/openroot/agape_net/ipfs}"
mkdir -p "$LEDGER_DIR" "$IPFS_DIR"

log()  { printf '%s\n' "$*" >&2; }
die()  { log "error: $*"; exit 1; }

cmd_version() { echo "agape-ipfs $VERSION"; }
cmd_help() {
  cat << HELP
Usage: agape-ipfs <command> [args]

  pin <path>     Local-first pin (Pinata fallback if PINATA_JWT set)
  status         Last 12 ledger entries
  get <cid>      Fetch via public gateway
  hash <path>    Deterministic SHA-256 tree hash
  proof <cid>    Markdown proof + optional gist
  return <cid>   Trace lineage in ledger
  verify <cid>   Gateway reachability check
  version        Print version
  help           This message
HELP
}

cmd_hash() {
  local target="${1:-}"
  [ -n "$target" ] || die "hash requires a path"
  if [ -f "$target" ]; then
    sha256sum "$target" | awk '{print $1}'
  elif [ -d "$target" ]; then
    find "$target" -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}'
  else
    die "path not found: $target"
  fi
}

cmd_status() {
  local ledger="$LEDGER_DIR/pins.jsonl"
  if [ ! -f "$ledger" ]; then
    echo "(empty ledger)"
    return 0
  fi
  tail -n 12 "$ledger"
}

cmd_pin() {
  local path="${1:-}"
  [ -n "$path" ] || die "pin requires a path"
  local h
  h=$(cmd_hash "$path")
  local ts
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  local entry
  entry=$(printf '{"ts":"%s","node":"%s","path":"%s","sha256":"%s","cid":null}\n' \
    "\( ts" " \)(hostname 2>/dev/null || echo termux)" "$path" "$h")
  echo "$entry" >> "$LEDGER_DIR/pins.jsonl"
  log "ledger append: $h"
  echo "$h"
}

cmd_proof() {
  local cid="${1:-}"
  [ -n "$cid" ] || die "proof requires a cid"
  local out="\( IPFS_DIR/proof- \){cid}.md"
  cat > "$out" << PROOF
# agape-ipfs proof

- CID: \`$cid\`
- Generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)
- Node: $(hostname 2>/dev/null || echo termux)
- Ledger: $LEDGER_DIR/pins.jsonl

## Verification

\`\`\`
agape-ipfs verify $cid
\`\`\`
PROOF
  log "proof written: $out"
  echo "$out"
}

cmd_verify() {
  local cid="${1:-}"
  [ -n "$cid" ] || die "verify requires a cid"
  local url="https://ipfs.io/ipfs/$cid"
  if curl -sI -o /dev/null -w "%{http_code}" --max-time 8 "$url" | grep -qE '200|301|302'; then
    echo "reachable: $url"
  else
    echo "unreachable (or gateway timeout): $url"
  fi
}

cmd_get() {
  local cid="${1:-}"
  [ -n "$cid" ] || die "get requires a cid"
  curl -sL --max-time 30 "https://ipfs.io/ipfs/$cid"
}

cmd_return() {
  local cid="${1:-}"
  [ -n "$cid" ] || die "return requires a cid"
  local ledger="$LEDGER_DIR/pins.jsonl"
  [ -f "$ledger" ] || die "no ledger"
  grep -F "$cid" "$ledger" || echo "(no lineage found)"
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    version) cmd_version ;;
    help|-h|--help) cmd_help ;;
    pin) cmd_pin "$@" ;;
    status) cmd_status ;;
    hash) cmd_hash "$@" ;;
    proof) cmd_proof "$@" ;;
    verify) cmd_verify "$@" ;;
    get) cmd_get "$@" ;;
    return) cmd_return "$@" ;;
    *) die "unknown command: $cmd (try help)" ;;
  esac
}
main "$@"
