#!/data/data/com.termux/files/usr/bin/env python3
"""conv-archaeologist v1.0 — Mine conversation logs for project state.
Universal nomenclature: axioms (confirmed), postulates (assumed),
peaks (worked), unsolved (failed), artifacts (created), links (cross-device).

Usage:
  conv-archaeologist < conversation.txt              # stdin
  conv-archaeologist -f ~/llama.log                 # file input
  conv-archaeologist -f ~/.shortcuts/tasks/output.log --send-groq  # LLM analyze
  conv-archaeologist -f convo.txt --store            # save to knowledge base
"""
import sys,os,re,json,argparse,datetime,urllib.request,hashlib
from pathlib import Path

KB_DIR = Path.home()/".openroot"/"knowledge-base"
KB_DIR.mkdir(parents=True,exist_ok=True)

# ── PATTERN LIBRARY ──
PATTERNS = {
    "peaks": [
        r'(?:SUCCESS|COMPILES OK|DELETED|SERVER UP|BUILD COMPLETE|PASSED|✓|installed|configured)',
        r'(?:worked|fixed|resolved|solved|done|complete)',
        r'\[BUILD\].*(?:complete|success|pass)',
        r'exit code 0',
    ],
    "unsolved": [
        r'(?:FAILED|ERROR|Traceback|Exception|CRITICAL|ABORT|segmentation)',
        r'(?:not found|cannot find|No such file|permission denied|not supported)',
        r'(?:undefined reference|collect2.*ld returned|compilation terminated)',
        r'(?:JSONDecodeError|KeyError|ImportError|ModuleNotFoundError)',
        r'(?:BLOCK\b|FORCED|FATAL)',
        r'(?:TODO|FIXME|HACK|XXX|TEMPORARY)',
        r'(?:stuck|broken|doesn.t work|won.t run|can.t find)',
    ],
    "artifacts": [
        r'(?:cat >|cat >>|tee |echo.*>).*?(/[^\s|>;]+)',
        r'(?:chmod|mkdir|touch|cp |mv |ln -s)',
        r'(?:git clone|git init|git add|git commit)',
        r'(?:pkg install|pip install|npm install)',
        r'(?:cmake|make|ninja|gcc|clang)',
        r'(?:nohup.*&)',
    ],
    "configs": [
        r'(?:export\s+\w+_KEY|export\s+LD_LIBRARY|export\s+PATH|export\s+CC|export\s+CXX)',
        r'(?:\.env|config\.json|settings\.py|\.bashrc|\.profile)',
        r'(?:GROQ_API_KEY|GEMINI_API_KEY|OPENROUTER_API_KEY|GH_TOKEN)',
    ],
    "devices": [
        r'(?:Windows|linux|wsl|WSL)',
        r'(?:Android|Termux|termux|A15|Samsung|arm64|aarch64)',
        r'(?:\/storage\/|\/sdcard\/|\/data\/data\/com\.termux)',
        r'(?:C:\\|D:\\|\\\\wsl)',
    ],
    "models": [
        r'(?:[\w\-]+\.gguf)',
        r'(?:llama-server|llama-cli|llama-bench|llama-cpp)',
        r'(?:qwen|phi-3|mistral|llama-3|gemma|deepseek)',
    ],
    "commands_run": [
        r'^~ \$ (.+)$',
        r'^\$ (.+)$',
    ],
}

AXIOM_PROMPT = """You are a systems archaeologist. Given conversation artifacts from a developer's
Termux/Android environment, produce a formal knowledge representation using:

AXIOMS — confirmed truths (things that compiled, ran successfully, verified working)
POSTULATES — reasonable assumptions connecting scattered evidence across devices
THEOREMS — derivable conclusions from axioms + postulates
UNSOLVED — open problems, unresolved errors, missing pieces
ARTIFACTS — files/scripts/configs created or modified
CROSS-DEVICE LINKS — evidence of project fragments split between Windows and Android

Format each as numbered statements. Be precise. Reference exact file paths, model names,
error strings. If you infer something, mark it [INFERRED]. If confirmed by evidence, mark [CONFIRMED].
Only output the formal representation, no preamble."""

def classify_line(line, context_lines):
    """Classify a line into categories based on pattern matches."""
    hits = []
    for category, patterns in PATTERNS.items():
        for pat in patterns:
            if re.search(pat, line, re.IGNORECASE):
                hits.append(category)
                break
    return hits

def extract_context(lines, idx, radius=3):
    """Get surrounding lines for context."""
    start = max(0, idx - radius)
    end = min(len(lines), idx + radius + 1)
    return "\n".join(f"{i+1:4d}| {lines[i]}" for i in range(start, end))

def analyze(text):
    """Main analysis — extract all artifacts from raw conversation text."""
    lines = text.splitlines()
    results = {
        "meta": {
            "analyzed_at": datetime.datetime.now().isoformat(timespec="seconds"),
            "total_lines": len(lines),
            "input_hash": hashlib.sha256(text.encode()).hexdigest()[:12],
        },
        "peaks": [],
        "unsolved": [],
        "artifacts": [],
        "configs": [],
        "device_refs": [],
        "models_found": [],
        "commands_executed": [],
        "axioms": [],
        "postulates": [],
        "cross_device": [],
    }

    seen_cmds = set()
    seen_files = set()

    for idx, line in enumerate(lines):
        line_s = line.rstrip()
        if not line_s.strip():
            continue

        cats = classify_line(line_s, lines)

        ctx = extract_context(lines, idx)

        if "peaks" in cats:
            # Try to identify what succeeded
            m = re.search(r'(?:cat >|cat >>)\s+(.+?)(?:\s|<)', line_s)
            if m and m.group(1) not in seen_files:
                results["artifacts"].append({"line": idx+1, "file": m.group(1), "ctx": ctx})
                seen_files.add(m.group(1))
            results["peaks"].append({"line": idx+1, "text": line_s.strip()[:200], "ctx": ctx})

        if "unsolved" in cats:
            results["unsolved"].append({"line": idx+1, "text": line_s.strip()[:200], "ctx": ctx})

        if "artifacts" in cats:
            for m in re.finditer(r'(?:cat >|cat >>|tee |echo.*>)\s*(/[^\s|>;]+|[~/][^\s|>;]+)', line_s):
                fp = m.group(1)
                if fp not in seen_files:
                    results["artifacts"].append({"line": idx+1, "file": fp, "action": "create", "ctx": ctx})
                    seen_files.add(fp)
            if re.search(r'(?:chmod|mkdir|cp |mv |ln -s|pkg install|pip install)', line_s):
                results["artifacts"].append({"line": idx+1, "text": line_s.strip()[:200], "action": "modify", "ctx": ctx})

        if "configs" in cats:
            results["configs"].append({"line": idx+1, "text": line_s.strip()[:200], "ctx": ctx})

        if "devices" in cats:
            results["device_refs"].append({"line": idx+1, "text": line_s.strip()[:200], "ctx": ctx})

        if "models" in cats:
            for m in re.finditer(r'([\w\-]+\.gguf)', line_s):
                if m.group(1) not in [x.get("name") for x in results["models_found"]]:
                    results["models_found"].append({"line": idx+1, "name": m.group(1), "ctx": ctx})
            for m in re.finditer(r'(llama-\w+)', line_s):
                if m.group(1) not in [x.get("name") for x in results["models_found"]]:
                    results["models_found"].append({"line": idx+1, "name": m.group(1), "ctx": ctx})

        if "commands_run" in cats:
            for pat in PATTERNS["commands_run"]:
                m = re.match(pat, line_s)
                if m:
                    cmd = m.group(1).strip()
                    if cmd and len(cmd) > 3 and cmd not in seen_cmds and not cmd.startswith("#"):
                        results["commands_executed"].append({"line": idx+1, "cmd": cmd[:200]})
                        seen_cmds.add(cmd)
                    break

    # ── DERIVE AXIOMS (confirmed from peaks) ──
    for p in results["peaks"]:
        t = p["text"]
        if re.search(r'COMPILES OK', t):
            fname = re.search(r'([\w\-]+)\.py', t) or re.search(r'([\w\-/]+)$', t)
            results["axioms"].append({
                "id": f"A{len(results['axioms'])+1}",
                "statement": f"Script compiles successfully — confirmed by py_compile",
                "evidence": t,
                "line": p["line"],
                "status": "CONFIRMED",
            })
        elif re.search(r'SERVER UP', t):
            results["axioms"].append({
                "id": f"A{len(results['axioms'])+1}",
                "statement": "llama-server starts and accepts HTTP connections on port 8080",
                "evidence": t,
                "line": p["line"],
                "status": "CONFIRMED",
            })
        elif re.search(r'\[DELETED\]', t):
            results["axioms"].append({
                "id": f"A{len(results['axioms'])+1}",
                "statement": f"File deletion succeeded via or-manifest: {t[:100]}",
                "evidence": t,
                "line": p["line"],
                "status": "CONFIRMED",
            })

    # ── DERIVE POSTULATES (from cross-device evidence) ──
    device_types = set()
    for d in results["device_refs"]:
        t = d["text"]
        if re.search(r'Windows|WSL|wsl|C:\\|D:\\', t, re.I):
            device_types.add("Windows")
        if re.search(r'Android|Termux|A15|arm64|/data/data/com.termux|/sdcard|/storage', t, re.I):
            device_types.add("Android")

    if "Windows" in device_types and "Android" in device_types:
        results["postulates"].append({
            "id": f"P{len(results['postulates'])+1}",
            "statement": "Project fragments exist on both Windows and Android — files may need synchronization",
            "evidence": "Device references found for both platforms",
            "status": "INFERRED",
        })

    # Model locations suggest cross-device storage
    storage_refs = [d for d in results["device_refs"] if "/storage/" in d["text"] or "/sdcard/" in d["text"]]
    if storage_refs:
        results["postulates"].append({
            "id": f"P{len(results['postulates'])+1}",
            "statement": "External storage (/storage/0000-0000 or /sdcard) used as bridge between devices — possible sync point",
            "evidence": f"{len(storage_refs)} references to shared storage paths",
            "status": "INFERRED",
        })

    # ── DERIVE CROSS-DEVICE LINKS ──
    for d in results["device_refs"]:
        t = d["text"]
        if re.search(r'/storage/0000-0000', t):
            results["cross_device"].append({"line": d["line"], "link": "SD card shared storage", "text": t[:150]})
        if re.search(r'/sdcard/', t):
            results["cross_device"].append({"line": d["line"], "link": "Internal shared storage", "text": t[:150]})

    return results

def render_report(r):
    """Human-readable report with axiom/postulate nomenclature."""
    lines = []
    lines.append("=" * 60)
    lines.append("CONVERSATION ARCHAEOLOGY REPORT")
    lines.append(f"Input: {r['meta']['total_lines']} lines | hash:{r['meta']['input_hash']}")
    lines.append(f"Analyzed: {r['meta']['analyzed_at']}")
    lines.append("=" * 60)

    lines.append(f"\n{'─'*40}")
    lines.append("AXIOMS (Confirmed Truths)")
    lines.append(f"{'─'*40}")
    if r["axioms"]:
        for a in r["axioms"]:
            lines.append(f"  [{a['id']}] [{a['status']}] {a['statement']}")
            lines.append(f"       evidence L{a['line']}: {a['evidence'][:120]}")
    else:
        lines.append("  (none derived)")

    lines.append(f"\n{'─'*40}")
    lines.append("POSTULATES (Assumed Connections)")
    lines.append(f"{'─'*40}")
    if r["postulates"]:
        for p in r["postulates"]:
            lines.append(f"  [{p['id']}] [{p['status']}] {p['statement']}")
            lines.append(f"       evidence: {p['evidence']}")
    else:
        lines.append("  (none derived)")

    lines.append(f"\n{'─'*40}")
    lines.append("PEAKS (Things That Worked)")
    lines.append(f"{'─'*40}")
    for p in r["peaks"][:20]:
        lines.append(f"  L{p['line']:4d} {p['text'][:120]}")
    if len(r["peaks"]) > 20:
        lines.append(f"  ... and {len(r['peaks'])-20} more")

    lines.append(f"\n{'─'*40}")
    lines.append("UNSOLVED (Open Problems)")
    lines.append(f"{'─'*40}")
    for u in r["unsolved"][:20]:
        lines.append(f"  L{u['line']:4d} {u['text'][:120]}")
    if len(r["unsolved"]) > 20:
        lines.append(f"  ... and {len(r['unsolved'])-20} more")

    lines.append(f"\n{'─'*40}")
    lines.append("ARTIFACTS (Created/Modified)")
    lines.append(f"{'─'*40}")
    for a in r["artifacts"][:20]:
        if "file" in a:
            lines.append(f"  L{a['line']:4d} → {a['file']}")
        else:
            lines.append(f"  L{a['line']:4d} {a.get('text','')[:100]}")

    lines.append(f"\n{'─'*40}")
    lines.append("MODELS FOUND")
    lines.append(f"{'─'*40}")
    for m in r["models_found"]:
        lines.append(f"  L{m['line']:4d} {m['name']}")

    lines.append(f"\n{'─'*40}")
    lines.append("CONFIGS / ENVIRONMENT")
    lines.append(f"{'─'*40}")
    for c in r["configs"][:15]:
        lines.append(f"  L{c['line']:4d} {c['text'][:100]}")

    lines.append(f"\n{'─'*40}")
    lines.append("CROSS-DEVICE LINKS")
    lines.append(f"{'─'*40}")
    if r["cross_device"]:
        for c in r["cross_device"]:
            lines.append(f"  L{c['line']:4d} [{c['link']}] {c['text'][:100]}")
    else:
        lines.append("  (none detected)")

    lines.append(f"\n{'─'*40}")
    lines.append("COMMANDS EXECUTED (unique)")
    lines.append(f"{'─'*40}")
    for c in r["commands_executed"][:30]:
        lines.append(f"  L{c['line']:4d} {c['cmd'][:120]}")
    if len(r["commands_executed"]) > 30:
        lines.append(f"  ... and {len(r['commands_executed'])-30} more")

    lines.append("\n" + "=" * 60)
    return "\n".join(lines)

def call_groq(summary_text):
    """Send analysis to Groq for deeper axiom/postulate derivation."""
    key = os.environ.get("GROQ_API_KEY")
    if not key:
        return None
    body = json.dumps({
        "model": "llama-3.3-70b-versatile",
        "messages": [
            {"role": "system", "content": AXIOM_PROMPT},
            {"role": "user", "content": f"Analyze this conversation archaeology dump:\n\n{summary_text[:8000]}"},
        ],
        "max_tokens": 4096,
        "temperature": 0.3,
    }).encode("utf-8")
    req = urllib.request.Request(
        "https://api.groq.com/openai/v1/chat/completions",
        data=body,
        headers={"Content-Type":"application/json","Authorization":f"Bearer {key}"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return data["choices"][0]["message"]["content"].strip()
    except Exception as e:
        print(f"[GROQ ERROR] {e}")
        return None

def main():
    ap = argparse.ArgumentParser(prog="conv-archaeologist")
    ap.add_argument("-f","--file", help="Input file (default: stdin)")
    ap.add_argument("--store", action="store_true", help="Save to knowledge base (~/.openroot/knowledge-base/)")
    ap.add_argument("--send-groq", action="store_true", help="Send summary to Groq for LLM-powered axiom derivation")
    ap.add_argument("--json", action="store_true", help="Output raw JSON instead of report")
    args = ap.parse_args()

    if args.file:
        text = Path(args.file).expanduser().read_text(errors="replace")
    else:
        text = sys.stdin.read()

    if not text.strip():
        print("[ERROR] No input. Usage: conv-archaeologist -f logfile.txt  OR  cat convo.txt | conv-archaeologist")
        sys.exit(1)

    results = analyze(text)
    report = render_report(results)

    if args.json:
        print(json.dumps(results, indent=1))
    else:
        print(report)

    if args.send_groq:
        print("\n" + "=" * 60)
        print("LLM-DERIVED AXIOMATIC ANALYSIS (Groq llama-3.3-70b)")
        print("=" * 60)
        llm_out = call_groq(report)
        if llm_out:
            print(llm_out)
            results["llm_analysis"] = llm_out
        else:
            print("[SKIPPED] No GROQ_API_KEY set. Run: source ~/.config/llm-apis/keys.env")

    if args.store:
        ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        out = KB_DIR / f"dig_{ts}_{results['meta']['input_hash']}.json"
        out.write_text(json.dumps(results, indent=1))
        print(f"\n[STORED] {out}")
        # Also append markdown summary
        md = KB_DIR / "knowledge.md"
        with open(md, "a") as f:
            f.write(f"\n\n---\n## Dig {ts} (hash:{results['meta']['input_hash']})\n\n{report}\n")
        print(f"[APPENDED] {md}")

if __name__ == "__main__":
    main()
