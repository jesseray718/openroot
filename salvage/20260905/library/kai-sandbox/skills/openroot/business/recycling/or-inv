#!/data/data/com.termux/files/usr/bin/python3
import sys, os, csv, datetime

INV_DIR = os.path.expanduser("~/projects/openroot/business/recycling/inventory")
LOG_DIR = os.path.expanduser("~/projects/openroot/business/recycling/logs")
os.makedirs(INV_DIR, exist_ok=True)
os.makedirs(LOG_DIR, exist_ok=True)

def gen_id():
    ts = datetime.datetime.now().strftime("%y%m%d%H%M%S")
    return f"INV-{ts}"

def add(device_type, source, status, notes=""):
    inv_id = gen_id()
    date = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    row = [inv_id, date, device_type, source, status, notes]
    inv_file = os.path.join(INV_DIR, "inventory.csv")
    exists = os.path.exists(inv_file)
    with open(inv_file, "a", newline="") as f:
        w = csv.writer(f)
        if not exists:
            w.writerow(["ID","Date","DeviceType","Source","Status","Notes"])
        w.writerow(row)
    log(inv_id, f"Added: {device_type} from {source} — {status}")
    print(f"Logged: {inv_id} | {device_type} | {source} | {status}")

def update(inv_id, new_status, notes=""):
    inv_file = os.path.join(INV_DIR, "inventory.csv")
    rows = []
    found = False
    with open(inv_file, "r") as f:
        r = csv.reader(f)
        header = next(r)
        for row in r:
            if row[0] == inv_id:
                row[4] = new_status
                if notes:
                    row[5] = notes
                found = True
            rows.append(row)
    with open(inv_file, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(header)
        w.writerows(rows)
    if found:
        log(inv_id, f"Updated to: {new_status} — {notes}")
        print(f"Updated: {inv_id} -> {new_status}")
    else:
        print(f"Not found: {inv_id}")

def list_all():
    inv_file = os.path.join(INV_DIR, "inventory.csv")
    if not os.path.exists(inv_file):
        print("No inventory yet.")
        return
    with open(inv_file) as f:
        r = csv.reader(f)
        for row in r:
            print(" | ".join(row))

def stats():
    inv_file = os.path.join(INV_DIR, "inventory.csv")
    if not os.path.exists(inv_file):
        print("No inventory yet.")
        return
    counts = {}
    with open(inv_file) as f:
        r = csv.reader(f)
        next(r)
        for row in r:
            s = row[4]
            counts[s] = counts.get(s, 0) + 1
    print("=== INVENTORY STATS ===")
    for s, c in sorted(counts.items()):
        print(f"  {s}: {c}")
    print(f"  TOTAL: {sum(counts.values())}")

def log(inv_id, msg):
    log_file = os.path.join(LOG_DIR, "audit.log")
    ts = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with open(log_file, "a") as f:
        f.write(f"[{ts}] {inv_id}: {msg}
")

def cert(inv_id, client, method):
    cert_dir = os.path.expanduser("~/projects/openroot/business/recycling/certs")
    os.makedirs(cert_dir, exist_ok=True)
    date = datetime.datetime.now().strftime("%Y-%m-%d")
    cert_file = os.path.join(cert_dir, f"{inv_id}-{client}-cert.md")
    with open(cert_file, "w") as f:
        f.write(f"""# CERTIFICATE OF DATA DESTRUCTION

**Certificate ID:** {inv_id}
**Client:** {client}
**Date:** {date}
**Method:** {method}
**Issued by:** OpenRoot LLC (EIN on file)

This certifies that the device listed under {inv_id} has undergone secure data destruction via {method}. All data has been permanently rendered unrecoverable.

This certificate serves as legal documentation of compliant data disposal.

---

*OpenRoot LLC | github.com/jesseray718/openroot*
*Copyright: One Human Family | Licensed CC-BY-SA-4.0*
""")
    log(inv_id, f"Destruction certificate issued for {client} via {method}")
    print(f"Certificate: {cert_file}")

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("""Usage:
  or-inv add <type> <source> <status> [notes]
  or-inv update <id> <new_status> [notes]
  or-inv list
  or-inv stats
  or-inv cert <id> <client> <method>

Statuses: collected, wiped, destroyed, refurbished, deployed, sold, scrapped

Examples:
  or-inv add laptop "Smith Law Firm" collected "Dell Latitude E6440, no drive"
  or-inv add router "Tech Corp" collected "TP-Link WR841N, OpenWrt compatible"
  or-inv update INV-260707142301 wiped "DBAN 3-pass complete"
  or-inv cert INV-260707142301 "Smith Law Firm" "Physical drive crush"
""")
        sys.exit(0)

    cmd = sys.argv[1]
    if cmd == "add" and len(sys.argv) >= 5:
        notes = " ".join(sys.argv[6:]) if len(sys.argv) > 6 else ""
        add(sys.argv[2], sys.argv[3], sys.argv[4], notes)
    elif cmd == "update" and len(sys.argv) >= 4:
        notes = " ".join(sys.argv[5:]) if len(sys.argv) > 5 else ""
        update(sys.argv[2], sys.argv[3], notes)
    elif cmd == "list":
        list_all()
    elif cmd == "stats":
        stats()
    elif cmd == "cert" and len(sys.argv) >= 5:
        cert(sys.argv[2], sys.argv[3], sys.argv[4])
    else:
        print("Unknown command. Run: or-inv")
