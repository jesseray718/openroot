#!/data/data/com.termux/files/usr/bin/env python3
"""scatter-map v1.1 — Detect duplicated files/dirs across home tree.
FIX: v1.0 had substring bug in should_skip() — ".termux" matched "com.termux" in HOME path.
     Now uses path component set intersection instead of substring search.
"""
import os,sys,argparse
from pathlib import Path
from collections import defaultdict

HOME = Path.home()

# Skip these by checking individual path component names (not substrings)
SKIP_COMPONENTS = {
    ".cache",".termux","node_modules",".git","__pycache__","site-packages",
    "usr","lib","share","include","etc","var","tmp","proc","sys","dev",
    "psbuild","psutil_src","gguf-py","examples","tests","scripts",
    "CMakeFiles",".npm",".cargo",".rustup",". Gradle",".android",
}

# But DO track these dir names even if they appear only once
TRACK_NAMES = {"openroot","OpenRoot","llama.cpp","llama.cpp-fix","models","conversion","HYPER_STRUCTURE"}

def get_components(p):
    """Return set of path component names."""
    try:
        rel = p.relative_to(HOME)
        return set(rel.parts)
    except ValueError:
        return set(p.parts)

def should_skip(p):
    comps = get_components(p)
    return bool(SKIP_COMPONENTS & comps)

def find_all(root, maxdepth=5):
    dir_map = defaultdict(list)
    file_map = defaultdict(list)
    visited = set()
    
    for dirpath, dirnames, filenames in os.walk(root):
        dp = Path(dirpath)
        depth = len(dp.relative_to(HOME).parts) if dp != HOME else 0
        if depth > maxdepth:
            dirnames[:] = []
            continue
        if should_skip(dp):
            dirnames[:] = []
            continue
        if dirpath in visited:
            continue
        visited.add(dirpath)
        
        for d in dirnames:
            child = os.path.join(dirpath, d)
            dir_map[d].append(child)
        
        for f in filenames:
            fp = os.path.join(dirpath, f)
            try:
                sz = os.path.getsize(fp)
                file_map[f].append((fp, sz))
            except OSError:
                pass
    
    return dir_map, file_map

def analyze_dirs(dir_map):
    dupes = {}
    for name, paths in dir_map.items():
        if len(paths) < 2:
            continue
        # Deduplicate paths (symlinks etc.)
        uniq = list(dict.fromkeys(paths))
        if len(uniq) < 2:
            continue
        sizes = []
        for p in uniq:
            try:
                total = 0
                for dp, dn, fn in os.walk(p):
                    for f in fn:
                        try: total += os.path.getsize(os.path.join(dp, f))
                        except OSError: pass
                sizes.append(total)
            except Exception:
                sizes.append(0)
        dupes[name] = list(zip(uniq, sizes))
    return dupes

def analyze_files(file_map):
    dupes = {}
    for name, entries in file_map.items():
        if len(entries) < 2:
            continue
        if name in (".DS_Store","__init__.py",".gitkeep","README.md","LICENSE"):
            continue
        size_groups = defaultdict(list)
        for path, sz in entries:
            size_groups[sz].append(path)
        for sz, paths in size_groups.items():
            if len(paths) >= 2:
                dupes.setdefault(name, []).extend([(p, sz) for p in paths])
    return dupes

def main():
    ap = argparse.ArgumentParser(prog="scatter-map")
    ap.add_argument("--dedup", action="store_true")
    ap.add_argument("--top", type=int, default=30)
    ap.add_argument("--debug", action="store_true")
    args = ap.parse_args()
    
    print("=" * 65)
    print("SCATTER MAP v1.1 — Duplicate Detection Across ~/")
    print(f"HOME: {HOME}")
    print("=" * 65)
    
    dir_map, file_map = find_all(HOME)
    
    if args.debug:
        print(f"\n[DEBUG] dir_map has {len(dir_map)} unique dirnames")
        print(f"[DEBUG] file_map has {len(file_map)} unique filenames")
        for name in sorted(TRACK_NAMES):
            if name in dir_map:
                print(f"[DEBUG] '{name}' found at {len(dir_map[name])} paths:")
                for p in dir_map[name][:5]:
                    print(f"          {p}")
        print(f"[DEBUG] Total files scanned: {sum(len(v) for v in file_map.values())}")
    
    print(f"\n── DUPLICATED DIRECTORIES ({'showing top ' + str(args.top)}) ──")
    dup_dirs = analyze_dirs(dir_map)
    total_waste = 0
    shown = 0
    for name, entries in sorted(dup_dirs.items(), key=lambda x: -max(e[1] for e in x[1])):
        if shown >= args.top:
            break
        shown += 1
        print(f"\n  {name}/  ({len(entries)} copies)")
        paths_sorted = sorted(entries, key=lambda x: -x[1])
        canonical_path = paths_sorted[0][0]
        for path, sz in paths_sorted:
            mb = sz / (1024*1024)
            tag = "← CANONICAL" if path == canonical_path else f"← REDUNDANT ({mb:.1f}MB)"
            if path != canonical_path:
                total_waste += sz
            print(f"    {mb:9.1f}MB  {tag}")
            print(f"              {path}")
    
    print(f"\n── DUPLICATED FILES (same name + size) ──")
    dup_files = analyze_files(file_map)
    fshown = 0
    for name, entries in sorted(dup_files.items()):
        if fshown >= args.top:
            break
        paths = [(e[0], e[1]) for e in entries]
        if len(paths) >= 2:
            fshown += 1
            uniq_paths = list(dict.fromkeys(p for p, _ in paths))
            sz = paths[0][1] if paths else 0
            print(f"\n  {name}  ({len(uniq_paths)} copies, {sz} bytes each)")
            for p in sorted(uniq_paths)[:10]:
                print(f"    {p}")
            if len(uniq_paths) > 10:
                print(f"    ... +{len(uniq_paths)-10} more")
    
    print(f"\n{'─'*50}")
    print(f"ESTIMATED WASTE FROM REDUNDANT DIRS: {total_waste/(1024*1024):.0f}MB")
    print(f"DUPLICATED DIRS: {len(dup_dirs)} | DUPLICATED FILES: {len(dup_files)}")
    print(f"{'─'*50}")
    
    if args.dedup and dup_dirs:
        print("\n── DRY-RUN DEDUP COMMANDS (review before executing) ──")
        for name, entries in dup_dirs.items():
            paths_sorted = sorted(entries, key=lambda x: -x[1])
            for path, sz in paths_sorted[1:]:
                print(f"# rm -rf '{path}'  # {sz/(1024*1024):.1f}MB redundant copy of {name}/")
    
    print("\n=== AXIOMATIC SUMMARY ===")
    for name in TRACK_NAMES:
        if name in dup_dirs:
            n = len(dup_dirs[name])
            waste = sum(sz for _, sz in sorted(dup_dirs[name], key=lambda x: -x[1])[1:])
            print(f"  [AXIOM] {name} exists in {n} locations — {waste/(1024*1024):.0f}MB recoverable")
    
    if dup_files:
        total_dup_files = sum(len(set(p for p, _ in entries)) for entries in dup_files.values())
        print(f"  [AXIOM] {len(dup_files)} filenames duplicated across {total_dup_files} paths")
    
    print(f"  [AXIOM] Total recoverable space: ~{total_waste/(1024*1024):.0f}MB")
    print(f"  [POSTULATE] /storage/0000-0000 serves as cross-device bridge — may contain stale copies")
    print(f"  [POSTULATE] Canonical layout: ~/projects/openroot/ (code), ~/llama.cpp-fix/ (build), ~/models/ (GGUF)")
    print(f"  [UNSOLVED] ~/~ literal directory — tilde expansion bug")
    print(f"  [UNSOLVED] GitHub not authenticated — sync status undetermined")

if __name__ == "__main__":
    main()
