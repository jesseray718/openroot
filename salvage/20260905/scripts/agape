#!/data/data/com.termux/files/usr/bin/bash
set -eu

ROOT=/sdcard/openroot
PY=python
command -v python >/dev/null 2>&1 || PY=python3

start_loops() {
  nohup bash "$ROOT/scripts/agape-health.sh"   >"$ROOT/logs/health.out" 2>&1 &
  nohup bash "$ROOT/scripts/agape-keeper.sh"   >"$ROOT/logs/keeper.out" 2>&1 &
  nohup bash "$ROOT/scripts/agape-autopilot.sh" >"$ROOT/logs/nohup.out" 2>&1 &
  echo "[ok] loops started"
}

stop_loops() {
  pkill -f agape-autopilot.sh || true
  pkill -f agape-health.sh || true
  pkill -f agape-keeper.sh || true
  echo "[ok] loops stopped"
}

status_all() {
  "$PY" "$ROOT/src/nodes/agape-node/agape_node.py" status || true
  echo "---"
  pgrep -af "agape-autopilot.sh|agape-health.sh|agape-keeper.sh" || echo "no loops"
  echo "---"
  [ -f "$ROOT/storage/agape_node/throttle.json" ] && cat "$ROOT/storage/agape_node/throttle.json" || echo "no throttle"
  echo "---"
  tail -n 15 "$ROOT/logs/agape-autopilot.log" 2>/dev/null || true
}

set_mode() {
  MODE="${1:-normal}"
  case "$MODE" in
    boost) LIMIT=50; SLEEP=3;;
    normal) LIMIT=20; SLEEP=10;;
    conserve) LIMIT=8; SLEEP=20;;
    cooldown) LIMIT=5; SLEEP=30;;
    *) echo "usage: agape mode boost|normal|conserve|cooldown"; exit 1;;
  esac
  mkdir -p "$ROOT/storage/agape_node"
  cat > "$ROOT/storage/agape_node/throttle.json" <<EOF
{"mode":"$MODE","limit":$LIMIT,"sleep_ok":$SLEEP,"manual_override":true}
EOF
  echo "[ok] mode=$MODE limit=$LIMIT sleep_ok=$SLEEP"
}

enqueue_task() {
  TASK="${1:-passenger insight}"
  U="${2:-2}"
  I="${3:-2}"
  "$PY" "$ROOT/src/nodes/agape-node/agape_node.py" enqueue --payload "{\"task\":\"$TASK\",\"urgency\":$U,\"impact\":$I}"
}

case "${1:-}" in
  start) start_loops ;;
  stop) stop_loops ;;
  restart) stop_loops; sleep 1; start_loops ;;
  status) status_all ;;
  mode) set_mode "${2:-normal}" ;;
  enqueue) enqueue_task "${2:-}" "${3:-2}" "${4:-2}" ;;
  process) "$PY" "$ROOT/src/nodes/agape-node/agape_node.py" process --limit "${2:-25}" ;;
  backup) bash "$ROOT/scripts/agape-backup.sh" ;;
  restore) bash "$ROOT/scripts/agape-restore.sh" "${2:-latest}" ;;
  bundle) bash "$ROOT/scripts/agape-bundle.sh" ;;
  pack) bash "$ROOT/scripts/agape-release-pack.sh" ;;
  doctor)
    echo "== doctor =="
    command -v "$PY" >/dev/null && echo "[ok] python=$PY" || echo "[err] python missing"
    [ -f "$ROOT/src/nodes/agape-node/agape_node.py" ] && echo "[ok] node file" || echo "[err] missing node file"
    [ -f "$ROOT/scripts/agape-autopilot.sh" ] && echo "[ok] autopilot script" || echo "[err] missing autopilot"
    [ -d "$ROOT/storage/agape_node" ] && echo "[ok] storage dir" || echo "[warn] storage dir missing"
    ;;
  *)
    cat <<EOF
Agape super-command:
  bash /sdcard/openroot/scripts/agape start
  bash /sdcard/openroot/scripts/agape stop
  bash /sdcard/openroot/scripts/agape restart
  bash /sdcard/openroot/scripts/agape status
  bash /sdcard/openroot/scripts/agape mode boost|normal|conserve|cooldown
  bash /sdcard/openroot/scripts/agape enqueue "task text" [urgency] [impact]
  bash /sdcard/openroot/scripts/agape process [limit]
  bash /sdcard/openroot/scripts/agape backup
  bash /sdcard/openroot/scripts/agape restore [latest|/path/to/backup.tgz]
  bash /sdcard/openroot/scripts/agape bundle
  bash /sdcard/openroot/scripts/agape pack
  bash /sdcard/openroot/scripts/agape doctor
EOF
    ;;
esac
