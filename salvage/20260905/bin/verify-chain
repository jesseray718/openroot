#!/bin/bash
LEDGER="${1:-acre/LEDGER.jsonl}"
[[ ! -f "$LEDGER" ]] && { echo "Not found: $LEDGER"; exit 1; }
PREV_HASH="null"
LINE_NUM=0
BROKEN=0
TOTAL_ACRE=0
ENTRIES=0
echo "=== ACRE CHAIN VERIFICATION ==="
echo "Ledger: $LEDGER"
echo "---"
while IFS= read -r line; do
  [[ -z "$line" ]] && continue
  ((LINE_NUM++))
  THIS_PREV=$(echo "$line" | jq -r '.previous_hash // "MISSING"')
  ACRE=$(echo "$line" | jq -r '.acre_minted // 0')
  TOTAL_ACRE=$(awk "BEGIN{printf \"%.8f\", $TOTAL_ACRE + $ACRE}")
  ((ENTRIES++))
  ENTRY_ID=$(echo "$line" | jq -r '.entry_id // "unknown"')
  WORK_TYPE=$(echo "$line" | jq -r '.work_type // "unknown"')
  if [[ "$THIS_PREV" == "null" || -z "$THIS_PREV" ]]; then
    if ((LINE_NUM == 1)); then
      echo "[OK] Genesis entry — $ENTRY_ID"
    else
      echo "[!!] BROKEN at line $LINE_NUM — $ENTRY_ID"
      echo "     Expected: ${PREV_HASH:0:16}..."
      echo "     Got: empty/null"
      ((BROKEN++))
    fi
  elif [[ "$THIS_PREV" == "$PREV_HASH" ]]; then
    echo "[OK] Line $LINE_NUM — $ENTRY_ID ($WORK_TYPE)"
  else
    echo "[!!] MISMATCH at line $LINE_NUM — $ENTRY_ID"
    echo "     Expected: ${PREV_HASH:0:16}..."
    echo "     Got:      ${THIS_PREV:0:16}..."
    ((BROKEN++))
  fi
  PREV_HASH=$(echo -n "$line" | sha256sum | awk '{print $1}')
done < "$LEDGER"
echo "---"
echo "Entries: $ENTRIES"
echo "Broken links: $BROKEN"
echo "Total ACRE: $TOTAL_ACRE"
if ((BROKEN == 0)); then
  echo "STATUS: CHAIN INTACT"
  exit 0
else
  echo "STATUS: CHAIN BROKEN — $BROKEN broken link(s)"
  exit 1
fi
