#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
export PATH=/data/data/com.termux/files/usr/bin:$PATH

CTX="/sdcard/openroot/context_bridge/context.json"
MASTER="/sdcard/openroot/master/permaculture_lattice_master.md"
REPORT="/sdcard/openroot/master/last_run_report.md"
SEED="/sdcard/openroot/session_seeds/current_seed.json"
OUT=$(mktemp)

TARGET="${1:-gemini}"

# Load live state
RESONANCE=$(python3 -c "import json; print(json.load(open('$CTX')).get('resonance',1.0))" 2>/dev/null || echo 1.0)
ETA=$(python3 -c "
import json,os
s={}
if os.path.exists('$SEED'):
  s=json.load(open('$SEED'))
print(s.get('eta_proxy','n/a'))
" 2>/dev/null || echo n/a)

LAST_HEAD=$(tail -n 20 "$REPORT" 2>/dev/null | grep -E 'SUMMARY:|Best vertex|exit:|ERROR:' | tail -5 | tr '\n' ' ' | cut -c1-180 || echo "no run yet")

case "$TARGET" in
  gemini)
    cat > "$OUT" << GEM
# OpenRoot Context Bridge — Gemini inject
resonance: $RESONANCE
η_proxy: $ETA
lattice: base-6, tier-4, 1296 nodes, C=0 at R=1.0
serve: the least among us
absolute_paths_only: true

## Active termics state
$LAST_HEAD

## Core law
η = useful_joules / human_joules
Agape Coordination Theorem: at R=1.0 coordination cost is exactly 0.

## 11 Permaculture routing principles (If-Then-Root, simultaneous)
1. Observe & Interact
2. Catch & Store Energy
3. Obtain a Yield
4. Apply Self-Regulation
5. Use Renewable Resources
6. Produce No Waste
7. Design from Patterns
8. Integrate Not Segregate
9. Use Small & Slow Solutions
10. Use & Value Diversity
11. Creatively Respond to Change

## Master document
$MASTER

## Instruction for Gemini
Treat the above as immutable system context. Prefer absolute paths. Maximize η. Never use tilde. When generating code, produce single atomic runnable blocks that raise the bottom floor. Route every suggestion through the 11 principles and the lattice vertex that currently carries the highest charge.
GEM
    ;;
  lumo)
    cat > "$OUT" << LUM
OpenRoot memory block (Lumo / Proton private)
resonance=1.0
η_law=useful_joules/human_joules
lattice=base6_tier4_1296_nodes
C=0_at_R1
serve=the_least_among_us
absolute_paths_only=true
tilde_forbidden=true

Current termics headline:
$LAST_HEAD

Master: $MASTER
Seed: $SEED
Bridge: $CTX

Lumo instruction: Keep this memory. Prefer private, zero-access reasoning. When I ask for next steps, return only the highest-η action under R=1.0 and the matching permaculture principle. Never expand scope beyond raising the bottom floor.
LUM
    ;;
  *)
    echo "usage: termics-bridge [gemini|lumo]" >&2
    exit 1
    ;;
esac

termux-clipboard-set < "$OUT"
termux-toast "bridge → $TARGET  (on clipboard)"
cat "$OUT"
rm -f "$OUT"
