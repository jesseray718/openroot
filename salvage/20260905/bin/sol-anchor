#!/bin/bash
# sol-anchor: Anchor latest ACRE entry to Solana via memo tx
LEDGER="${1:-acre/LEDGER.jsonl}"
WALLET="${HOME}/.config/solana/keystore.json"

[[ ! -f "$LEDGER" ]] && { echo "No ledger"; exit 1; }

# Get last entry hash
LAST_LINE=$(tail -1 "$LEDGER")
ENTRY_HASH=$(echo -n "$LAST_LINE" | sha256sum | awk '{print $1}')

# Create memo
MEMO="ACRE:${ENTRY_HASH:0:16}"

echo "[>] Creating Solana memo tx: ${MEMO}..."
# Using Solana CLI if available, or fallback to curl to RPC
if command -v solana &>/dev/null; then
  solana program invoke MemoMemo \
    --keypair "$WALLET" \
    --message "$MEMO"
  TX_SIG=$?
elif command -v solana-keygen &>/dev/null; then
  # Fallback: curl to Helius/QuickNode
  MEMO_ENCODED=$(echo -n "$MEMO" | base64 | tr -d '\n')
  curl -s https://api.mainnet-beta.solana.com \
    -X POST \
    -H "Content-Type: application/json" \
    -d "{
      \"jsonrpc\":\"2.0\",\"id\":1,
      \"method\":\"sendTransaction\",
      \"params\":[
        \"$MEMO_ENCODED\",
        {
          \"encoding\":\"base64\",
          \"preflightCommitment\":\"confirmed\"
        }
      ]
    }"
else
  echo "[!] solana CLI required: pkg install solana"
  exit 1
fi

echo "[+] Anchored: $MEMO"
# Log to ledger
echo "{\"tx_type\": \"solana_anchor\", \"entry_hash\": \"$ENTRY_HASH\", \"memo\": \"$MEMO\", \"timestamp\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}" >> acre/ANCHOR_LOG.jsonl
