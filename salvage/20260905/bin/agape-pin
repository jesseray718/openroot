#!/data/data/com.termux/files/usr/bin/bash
# agape-pin — local-first IPFS pin + Cosmic Ledger (R=1.0 node)
# η = useful_joules / human_joules   |   pure bash + coreutils + curl + python3
set -euo pipefail
ROOT="${HOME}/openroot"
LEDGER="${ROOT}/agape_net/ledger/pins.jsonl"
GATEWAY="${IPFS_GATEWAY:-https://ipfs.io/ipfs}"
PINATA_URL="https://api.pinata.cloud/pinning/pinFileToIPFS"
NODE="${NODE_NAME:-$(hostname 2>/dev/null || echo A15)}"
API="http://127.0.0.1:5001/api/v0"

die()  { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
log()  { printf '[%s] %s\n' "$(date -u +%H:%M:%S)" "$*"; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing $1"; }

local_ipfs_alive() {
  curl -s --max-time 2 -X POST "${API}/id" >/dev/null 2>&1
}

tree_hash() {
  local p="$1"
  if [[ -d "$p" ]]; then
    find "$p" -type f -print0 | sort -z | xargs -0 sha256sum 2>/dev/null | sha256sum | awk '{print $1}'
  else
    sha256sum "$p" | awk '{print $1}'
  fi
}

secure_pinata() {
  local upload="$1" hdr resp
  [[ -n "${PINATA_JWT:-}" ]] || die "PINATA_JWT required when local IPFS is down"
  hdr=$(mktemp)
  printf 'Authorization: Bearer %s\n' "$PINATA_JWT" > "$hdr"
  resp=$(curl -s -X POST "$PINATA_URL" -H @"$hdr" -F "file=@${upload}")
  rm -f "$hdr"
  printf '%s' "$resp" | python3 -c 'import sys,json; print(json.load(sys.stdin)["IpfsHash"])' 2>/dev/null \
    || die "Pinata response invalid: $resp"
}

cmd_hash() {
  local p="${1:-}"
  [[ -n "$p" && -e "$p" ]] || die "path required"
  printf '%s\n' "$(tree_hash "$p")"
}

cmd_pin() {
  local p="${1:-}" cid sha ts
  [[ -n "$p" && -e "$p" ]] || die "path required"
  need curl; need sha256sum
  sha=$(tree_hash "$p")
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  if local_ipfs_alive; then
    log "local IPFS alive — R≈1.0 (zero external joules)"
    if [[ -d "$p" ]]; then
      cid=$(ipfs add -r -Q --cid-version=1 --pin=true "$p")
    else
      cid=$(ipfs add -Q --cid-version=1 --pin=true "$p")
    fi
  else
    log "local IPFS down — falling back to Pinata (catch & store from next nearest)"
    [[ -d "$p" ]] && die "directories require local IPFS daemon (Pinata single-file only)"
    need python3
    cid=$(secure_pinata "$p")
  fi
  [[ -n "$cid" ]] || die "empty CID"
  mkdir -p "$(dirname "$LEDGER")"
  printf '{"ts":"%s","node":"%s","path":"%s","cid":"%s","sha256":"%s"}\n' \
    "$ts" "$NODE" "$p" "$cid" "$sha" >> "$LEDGER"
  log "pinned  CID=$cid  SHA256=$sha"
  log "Verifying retrievability..."
  if curl -s --max-time 20 -o /dev/null -w "%{http_code}" "${GATEWAY}/${cid}" | grep -q "200"; then
    log "Verified: CID live on gateway"
  else
    log "WARNING: CID not yet propagating (first pin latency is normal)"
  fi
  printf '%s\n' "$cid"
}

cmd_status() {
  local lines alive="dead"
  local_ipfs_alive && alive="alive"
  lines=$(wc -l < "$LEDGER" 2>/dev/null || echo 0)
  printf 'node=%s  local_ipfs=%s  ledger_entries=%s  ledger=%s\n' "$NODE" "$alive" "$lines" "$LEDGER"
  if [[ "$lines" -gt 0 ]]; then
    printf '--- last 3 ---\n'
    tail -n 3 "$LEDGER"
  fi
}

cmd_get() {
  local cid="${1:-}"
  [[ -n "$cid" ]] || die "cid required"
  if local_ipfs_alive; then
    ipfs cat "$cid"
  else
    curl -s --max-time 60 "${GATEWAY}/${cid}"
  fi
}

cmd_proof() {
  local p="${1:-}"
  [[ -n "$p" ]] || die "path or cid required"
  if [[ -e "$p" ]]; then
    local h; h=$(tree_hash "$p")
    printf 'local_sha256=%s\n' "$h"
    grep -F "\"sha256\":\"$h\"" "$LEDGER" 2>/dev/null || printf 'no ledger match for this hash\n'
  else
    grep -F "\"cid\":\"$p\"" "$LEDGER" 2>/dev/null || die "cid not in ledger"
  fi
}

cmd_return() {
  local cid="${1:-}"
  [[ -n "$cid" ]] || die "cid required"
  [[ -f "$LEDGER" ]] || die "ledger empty"
  grep -F "$cid" "$LEDGER" | python3 -c '
import sys, json
for line in sys.stdin:
    d = json.loads(line)
    print(f"CID:    {d[\"cid\"]}")
    print(f"Time:   {d[\"ts\"]}")
    print(f"Path:   {d[\"path\"]}")
    print(f"Hash:   {d[\"sha256\"]}")
    print(f"Node:   {d[\"node\"]}")
    print(f"Access: https://ipfs.io/ipfs/{d[\"cid\"]}")
' 2>/dev/null || die "no match or python3 missing"
}

cmd_list() {
  [[ -f "$LEDGER" ]] || die "ledger empty"
  python3 -c '
import sys, json
with open("'"$LEDGER"'") as f:
    for line in f:
        d = json.loads(line)
        print(f"{d[\"ts\"]}  {d[\"cid\"][:16]}…  {d[\"path\"]}")
' 2>/dev/null || cat "$LEDGER"
}

cmd_verify() {
  local cid="${1:-}" code
  if [[ -n "$cid" ]]; then
    code=$(curl -s --max-time 15 -o /dev/null -w "%{http_code}" "${GATEWAY}/${cid}")
    [[ "$code" == "200" ]] && log "OK $cid" || log "FAIL $cid ($code)"
  else
    [[ -f "$LEDGER" ]] || die "ledger empty"
    while read -r line; do
      cid=$(printf '%s' "$line" | python3 -c 'import sys,json; print(json.load(sys.stdin)["cid"])' 2>/dev/null) || continue
      code=$(curl -s --max-time 10 -o /dev/null -w "%{http_code}" "${GATEWAY}/${cid}")
      [[ "$code" == "200" ]] && printf 'OK  %s\n' "$cid" || printf 'FAIL %s (%s)\n' "$cid" "$code"
    done < "$LEDGER"
  fi
}

usage() {
  cat << EOF
agape-pin — local-first Cosmic Ledger pin tool (Agape R=1.0 node)
Usage: agape-pin <cmd> [args]
  pin   <path>     hash + pin (local IPFS preferred, Pinata fallback)
  hash  <path>     deterministic tree/file SHA-256 only
  status           node + ledger + local daemon health
  get   <cid>      retrieve content (local first)
  proof <path|cid> show local hash + ledger match
  return <cid>     lineage back through ledger (return path to root)
  list             compact ledger view
  verify [cid]     check gateway reachability (all or one)
Env:  PINATA_JWT (only when local daemon down)
      NODE_NAME   IPFS_GATEWAY
Ledger: $LEDGER
EOF
}

case "${1:-}" in
  pin)    shift; cmd_pin "$@" ;;
  hash)   shift; cmd_hash "$@" ;;
  status) cmd_status ;;
  get)    shift; cmd_get "$@" ;;
  proof)  shift; cmd_proof "$@" ;;
  return) shift; cmd_return "$@" ;;
  list)   cmd_list ;;
  verify) shift; cmd_verify "$@" ;;
  help|-h|--help|"") usage ;;
  *) die "unknown command: $1 (try help)" ;;
esac
