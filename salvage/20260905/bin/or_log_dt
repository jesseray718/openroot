#!/data/data/com.termux/files/usr/bin/bash
# Minimal clear-night ΔT logger for Node-001
# Usage: bash $HOME/openroot/bin/or_log_dt

LOGDIR=/sdcard/openroot/nodes/node-001
mkdir -p "$LOGDIR"
LOGFILE="$LOGDIR/dt_log.txt"
SEED=/sdcard/openroot/openroot_seed.txt

echo
echo "Node-001 ΔT Logger"
echo "Enter surface temperature (C):"
read SURFACE
echo "Enter air temperature (C):"
read AIR

DELTA=$(echo "$AIR - $SURFACE" | bc -l 2>/dev/null || echo "calc_error")
STAMP=$(date -u +"%Y-%m-%dT%H:%MZ")

LINE="$STAMP | surface=$SURFACE | air=$AIR | delta=$DELTA"
echo "$LINE" >> "$LOGFILE"
echo "$LINE" >> "$SEED"

echo
echo "Logged:"
echo "$LINE"
echo
echo "Written to:"
echo "  $LOGFILE"
echo "  $SEED"
echo
echo "Any consistent positive delta raises α_A."
