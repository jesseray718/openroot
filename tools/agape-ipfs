#!/usr/bin/env bash
set -euo pipefail
ROOT="${OPENROOT:-$HOME/openroot}"
LEDGER="$ROOT/agape_net/ledger/pins.jsonl"
PROOF_DIR="$ROOT/agape_net/ipfs"
GATEWAY="${IPFS_GATEWAY:-https://ipfs.io/ipfs}"
PINATA_URL="https://api.pinata.cloud/pinning/pinFileToIPFS"
TS=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
NODE="jessey_ray_openroot"
log(){ printf '[%s] AGAPE_IPFS: %s\n' "\( TS" " \)*" >&2; }
die(){ log "ERROR: $*"; exit 1; }
usage(){ cat <<U
agape-ipfs pin <path>
agape-ipfs status
agape-ipfs get <cid> [outfile]
agape-ipfs hash <path>
agape-ipfs proof <cid>
Env: PINATA_JWT  GITHUB_TOKEN  IPFS_GATEWAY  OPENROOT
Local ipfs daemon preferred; falls back to Pinata.
U
exit 0; }
alive(){ command -v ipfs >/dev/null && curl -s --max-time 2 http://127.0.0.1:5001/api/v0/id >/dev/null; }
thash(){ if [[ -f $1 ]]; then sha256sum "$1"|awk '{print $1}'; else find "$1" -type f -print0|sort -z|xargs -0 sha256sum|sha256sum|awk '{print $1}'; fi; }
pin_local(){ ipfs add -r -Q --cid-version=1 --raw-leaves --pin=true "$1"; }
pin_pinata(){
  [[ -n ${PINATA_JWT:-} ]] || die "no local ipfs + PINATA_JWT unset"
  local t=$1 u=$1 c=
  if [[ -d \( t ]]; then u= \)(mktemp --suffix=.tgz); tar -czf "\( u" -C " \)(dirname "\( t")" " \)(basename "$t")"; c=$u; fi
  local r=$(curl -s -X POST "$PINATA_URL" -H "Authorization: Bearer $PINATA_JWT" -F "file=@$u")
  [[ -n $c ]] && rm -f "$c"
  local cid=$(echo "$r"|grep -o '"IpfsHash":"[^"]*"'|cut -d'"' -f4)
  [[ -n $cid ]] || die "pinata: $r"
  echo "$cid"
}
cmd_pin(){
  local t=${1:-}; [[ -n $t && -e $t ]] || die "path required"
  t=$(realpath "\( t"); local h= \)(thash "$t"); log "hash $h"
  local cid; if alive; then cid=$(pin_local "\( t"); else cid= \)(pin_pinata "$t"); fi
  mkdir -p "$(dirname "$LEDGER")"
  printf '{"ts":"%s","node":"%s","path":"%s","cid":"%s","sha256":"%s"}\n' "$TS" "$NODE" "$t" "$cid" "$h" >> "$LEDGER"
  echo "$cid"; log "CID $cid  $GATEWAY/$cid"
}
cmd_status(){ [[ -f $LEDGER ]] || { log "empty"; exit 0; }; tail -12 "$LEDGER"; }
cmd_get(){ local c=\( {1:-} o= \){2:-./$c}; [[ -n $c ]] || die "cid required"; curl -fsSL "$GATEWAY/$c" -o "$o"; log "saved $o"; }
cmd_hash(){ [[ -n ${1:-} && -e $1 ]] || die "path required"; thash "$(realpath "$1")"; }
cmd_proof(){
  local c=${1:-}; [[ -n $c ]] || die "cid required"
  local f="\( PROOF_DIR/proof- \){c:0:12}.md"
  printf '# OpenRoot IPFS Proof\n**ts** %s\n**node** %s\n**CID** `%s`\n**gw** %s/%s\n' "$TS" "$NODE" "$c" "$GATEWAY" "$c" > "$f"
  log "proof $f"
  if [[ -n ${GITHUB_TOKEN:-} ]]; then
    local body=$(printf '{"description":"OpenRoot IPFS %s","public":true,"files":{"ipfs_proof.md":{"content":%s}}}' "\( c" " \)(python3 -c "import json,sys; print(json.dumps(open('$f').read()))")")
    local url=$(curl -s -X POST https://api.github.com/gists -H "Authorization: token $GITHUB_TOKEN" -H "Accept: application/vnd.github.v3+json" -d "$body" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("html_url",""))' 2>/dev/null || true)
    [[ -n $url ]] && log "gist $url"
  fi
}
case ${1:-} in
  pin) shift; cmd_pin "$@";;
  status) cmd_status;;
  get) shift; cmd_get "$@";;
  hash) shift; cmd_hash "$@";;
  proof) shift; cmd_proof "$@";;
  -h|--help|help|"") usage;;
  *) die "unknown $1";;
esac
