{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRoot Design Packet Metadata",
  "type": "object",
  "required": [
    "schema_version",
    "design_id",
    "name",
    "slug",
    "version",
    "status",
    "evidence_level",
    "maintainer",
    "last_reviewed",
    "licenses",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "design_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$" },
    "name": { "type": "string", "minLength": 3 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+.*$" },
    "status": { "type": "string" },
    "evidence_level": { "type": "string", "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
    "maintainer": { "type": "string", "minLength": 1 },
    "last_reviewed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "licenses": { "type": "object" },
    "claim_boundary": { "type": "string", "minLength": 40 }
  }
}
