{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRoot Newton Chain Claim",
  "type": "object",
  "required": [
    "claim_id",
    "claim",
    "evidence",
    "assumptions",
    "verification",
    "status"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "candidate",
        "verified",
        "falsified",
        "superseded"
      ]
    }
  },
  "additionalProperties": false
}
